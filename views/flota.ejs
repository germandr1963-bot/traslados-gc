<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= t('flota_h1') || 'Flota' %> — Traslados GC</title>
  <link href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@500&family=Public+Sans:wght@400;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/estilos.css">
  <style>
    body { background: var(--gris-fondo); color: var(--texto-oscuro); min-height: 100vh; }
    header.app {
      background: var(--charcoal);
      padding: 16px 20px;
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      border-bottom: 3px solid var(--terracota);
    }
    header.app .marca {
      font-family: 'Big Shoulders Display', sans-serif;
      font-size: 28px;
      font-weight: 500;
      color: var(--texto-claro);
      letter-spacing: 2px;
      text-decoration: none;
      text-align: center;
      justify-self: center;
    }
    header.app a.nav { color: rgba(255,255,255,0.65); text-decoration: none; font-size: 14px; }
    header.app a.nav:hover { color: #fff; }
    header.app a.nav.izquierda { justify-self: start; }
    header.app a.nav.derecha { justify-self: end; }
    @media (max-width: 560px) {
      header.app { padding: 12px 14px; }
      header.app .marca { font-size: 19px; letter-spacing: 1px; }
      header.app a.nav { font-size: 12px; }
    }
    .breadcrumbs { font-size: 13px; color: var(--texto-muted); margin-bottom: 18px; }
    .breadcrumbs a { color: var(--texto-muted); text-decoration: none; }
    .breadcrumbs a:hover { text-decoration: underline; }
    .contenido { max-width: 860px; margin: 0 auto; padding: 40px 24px 80px; }
    h1 { font-family: 'Big Shoulders Display', sans-serif; font-size: clamp(32px, 6vw, 52px); margin-bottom: 12px; color: var(--texto-oscuro); text-align: center; }
    .subtitulo { color: var(--texto-muted); font-size: 16px; font-style: italic; text-align: center; margin-bottom: 28px; line-height: 1.6; }
    .badges-flota { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; margin-bottom: 48px; }
    .badge-flota { border: 1.5px solid var(--terracota); color: var(--terracota); border-radius: 20px; font-size: 12px; padding: 5px 16px; font-weight: 600; background: #fff; display: inline-flex; align-items: center; gap: 6px; }
    .badge-icono { font-size: 14px; line-height: 1; }
    .selector-flota { background: #fff; border: 1px solid var(--gris-borde); border-radius: 12px; padding: 24px; margin-bottom: 48px; }
    .selector-flota h2 { font-family: 'Big Shoulders Display', sans-serif; font-size: 28px; margin-bottom: 4px; color: var(--texto-oscuro); }
    .selector-bajada { font-size: 15px; font-weight: 600; color: var(--texto-oscuro); margin-bottom: 4px !important; }
    .selector-flota p { font-size: 13px; color: var(--texto-muted); margin-bottom: 18px; }
    .selector-campos { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 12px; margin-bottom: 14px; }
    .selector-campo label { display: block; font-size: 11px; font-weight: 600; color: var(--texto-muted); text-transform: uppercase; letter-spacing: 0.8px; margin-bottom: 6px; }
    .selector-campo select { width: 100%; padding: 9px 12px; border: 1px solid var(--gris-borde); border-radius: 8px; font-size: 14px; color: var(--texto-oscuro); background: var(--gris-fondo); font-family: 'Public Sans', sans-serif; }
    .selector-campo select:focus { outline: none; border-color: var(--terracota); }
    .btn-recomendar { width: 100%; background: var(--terracota); color: #fff; border: none; border-radius: 8px; padding: 11px; font-size: 14px; font-weight: 600; cursor: pointer; font-family: 'Public Sans', sans-serif; transition: background 0.15s; }
    .btn-recomendar:hover { background: var(--terracota-oscuro); }
    .selector-resultado { margin-top: 14px; padding: 14px 16px; background: var(--gris-fondo); border: 1px solid var(--gris-borde); border-radius: 8px; font-size: 13px; color: var(--texto-muted); text-align: center; display: none; }
    .selector-resultado.visible { display: block; }
    .selector-resultado strong { color: var(--texto-oscuro); font-size: 15px; display: block; margin-bottom: 4px; }
    .grid-flota { display: flex; flex-direction: column; gap: 20px; margin-bottom: 48px; }
    .tarjeta-cat { background: #fff; border: 1px solid var(--gris-borde); border-radius: 12px; overflow: hidden; }
    .tarjeta-cat-top { background: var(--gris-fondo); padding: 14px 20px; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--gris-borde); }
    .tarjeta-cat-nombre { font-family: 'Big Shoulders Display', sans-serif; font-size: 22px; color: var(--texto-oscuro); }
    .tarjeta-cat-cap { font-size: 12px; color: var(--texto-muted); margin-top: 2px; }
    .btn-reservar-cat { background: var(--terracota); color: #fff; border: none; border-radius: 8px; padding: 8px 18px; font-size: 13px; font-weight: 600; cursor: pointer; text-decoration: none; font-family: 'Public Sans', sans-serif; white-space: nowrap; }
    .btn-reservar-cat:hover { background: var(--terracota-oscuro); }
    .tarjeta-cat-body { padding: 18px 20px 12px; display: grid; grid-template-columns: 1fr 280px; gap: 20px; align-items: stretch; }
    .tarjeta-cat-desc { font-size: 13px; color: var(--texto-oscuro); line-height: 1.6; height: 180px; overflow: hidden; }
    .tarjeta-cat-foto { height: 180px; background: #fff; border-radius: 10px; overflow: hidden; border: 1px solid var(--gris-borde); }
    .tarjeta-cat-caract { padding: 4px 20px 16px; font-size: 12px; color: var(--texto-oscuro); line-height: 2; }
    .tarjeta-cat-foto img { width: 100%; height: 100%; object-fit: contain; display: block; }
    .tarjeta-cat-foto.sin-foto { display: flex; align-items: center; justify-content: center; }
    .tarjeta-cat-foto.sin-foto span { font-size: 11px; color: var(--texto-muted); }
    .bloque-eco { background: #e8f5e9; border-left: 5px solid #2e7d32; border-radius: 0 12px 12px 0; padding: 20px 24px; margin-bottom: 48px; }
    .bloque-eco h2 { font-family: 'Big Shoulders Display', sans-serif; font-size: 22px; color: #1b5e20; margin-bottom: 8px; }
    .bloque-eco p { font-size: 14px; color: #1b5e20; line-height: 1.7; }
    .faq-flota { margin-bottom: 48px; }
    .faq-flota h2 { font-family: 'Big Shoulders Display', sans-serif; font-size: 28px; color: var(--texto-oscuro); margin-bottom: 20px; text-align: center; }
    .faq-item { border-bottom: 1px solid var(--gris-borde); }
    .faq-pregunta { width: 100%; background: none; border: none; padding: 16px 0; font-size: 15px; font-weight: 600; color: var(--texto-oscuro); text-align: left; cursor: pointer; display: flex; justify-content: space-between; align-items: center; font-family: 'Public Sans', sans-serif; }
    .faq-pregunta .faq-icono { color: var(--terracota); font-size: 20px; transition: transform 0.2s; flex-shrink: 0; }
    .faq-pregunta.abierto .faq-icono { transform: rotate(45deg); }
    .faq-respuesta { font-size: 14px; color: var(--texto-muted); line-height: 1.7; padding-bottom: 16px; display: none; }
    .faq-respuesta.visible { display: block; }
    .cargando { text-align: center; color: var(--texto-muted); font-size: 14px; padding: 60px 0; }
    @media (max-width: 600px) {
      .contenido { padding: 24px 16px 60px; }
      .selector-campos { grid-template-columns: 1fr; }
      .tarjeta-cat-body { grid-template-columns: 1fr; }
      .tarjeta-cat-foto { height: 160px; }
    }
    footer { text-align: center; padding: 30px; color: var(--texto-muted); font-size: 13px; }
    footer a { color: var(--texto-muted); text-decoration: none; margin: 0 12px; font-size: 13px; }
    footer a:hover { color: var(--texto-oscuro); }
    .footer-links { margin-bottom: 12px; }
  </style>
</head>
<body>
  <header class="app">
    <a href="<%= lang === 'es' ? '/' : '/' + lang + '/' %>" class="nav izquierda"><%= t('nav_inicio') || 'Inicio' %></a>
    <a href="<%= lang === 'es' ? '/' : '/' + lang + '/' %>" class="marca">TRASLADOS · GC</a>
    <a href="<%= lang === 'es' ? '/contacto' : '/' + lang + '/' + (palabrasPaginas.contacto || 'contacto') %>" class="nav derecha"><%= t('nav_contacto') || 'Contacto' %></a>
  </header>

  <div class="contenido">
    <nav class="breadcrumbs">
      <a href="<%= lang === 'es' ? '/' : '/' + lang + '/' %>"><%= t('nav_inicio') || 'Inicio' %></a>
      <span> › </span>
      <span><%= t('home_footer_flota') || 'Flota' %></span>
    </nav>

    <h1><%= t('flota_h1') || 'Flota' %></h1>
    <p class="subtitulo"><%= t('flota_subtitulo') || '' %></p>

    <div class="badges-flota">
      <span class="badge-flota"><span class="badge-icono">🛡️</span><span><%= t('flota_badge_licencias') || 'Licencias VT / Taxi Oficial' %></span></span>
      <span class="badge-flota"><span class="badge-icono">🌿</span><span><%= t('flota_badge_eco') || 'Opción Eco / Híbridos' %></span></span>
      <span class="badge-flota"><span class="badge-icono">♿</span><span><%= t('flota_badge_pmr') || 'EuroTaxi Adaptado (PMR)' %></span></span>
      <span class="badge-flota"><span class="badge-icono">🏄</span><span><%= t('flota_badge_deportivo') || 'Espacio Surf, Bici & Golf' %></span></span>
    </div>

    <!-- SELECTOR -->
    <div class="selector-flota">
      <h2><%= t('flota_selector_titulo') || 'Asistente de Selección de Vehículo' %></h2>
      <p class="selector-bajada"><%= t('flota_selector_bajada') || '¿Qué vehículo necesitas?' %></p>
      <p><%= t('flota_selector_descripcion') || 'Selecciona tu equipaje y pasajeros y te recomendamos la categoría ideal' %></p>
      <div class="selector-campos">
        <div class="selector-campo">
          <label for="sel-pasajeros"><%= t('flota_selector_label_pax') || 'Pasajeros' %></label>
          <select id="sel-pasajeros">
            <option value="1">1 pasajero</option>
          </select>
        </div>
        <div class="selector-campo">
          <label for="sel-maletas"><%= t('flota_selector_label_mal') || 'Maletas grandes' %></label>
          <select id="sel-maletas">
            <option value="0"><%= t('flota_selector_mal_0') || 'Sin maletas' %></option>
            <option value="1"><%= t('flota_selector_mal_1') || '1 maleta' %></option>
            <option value="2" selected><%= t('flota_selector_mal_2') || '2 maletas' %></option>
            <option value="3"><%= t('flota_selector_mal_3') || '3 maletas' %></option>
            <option value="4"><%= t('flota_selector_mal_4') || '4 maletas' %></option>
            <option value="5"><%= t('flota_selector_mal_5') || '5 o más maletas' %></option>
          </select>
        </div>
        <div class="selector-campo">
          <label for="sel-especial"><%= t('flota_selector_label_esp') || 'Equipaje especial' %></label>
          <select id="sel-especial">
            <option value="ninguno"><%= t('flota_selector_esp_ninguno') || 'Ninguno' %></option>
          </select>
        </div>
      </div>
      <button class="btn-recomendar" onclick="recomendar()"><%= t('flota_selector_btn') || 'Ver vehículo recomendado' %></button>
      <div class="selector-resultado" id="selector-resultado"></div>
    </div>

    <!-- CATÁLOGO -->
    <h2 style="font-family:'Big Shoulders Display',sans-serif;font-size:28px;color:var(--texto-oscuro);margin-bottom:20px;text-align:center;"><%= t('flota_catalogo_titulo') || 'Nuestras Categorías de Vehículos' %></h2>
    <div class="grid-flota" id="grid-flota">
      <div class="cargando"><%= t('flota_catalogo_cargando') || 'Cargando vehículos...' %></div>
    </div>

    <!-- BLOQUE ECO -->
    <div class="bloque-eco">
      <h2><%= t('flota_eco_titulo') || '🌱 Nuestro Compromiso con la Biosfera de Gran Canaria' %></h2>
      <p><%= t('flota_eco_texto') || '' %></p>
    </div>

    <!-- FAQ -->
    <div class="faq-flota">
      <h2><%= t('flota_faq_titulo') || 'Preguntas Frecuentes sobre la Flota' %></h2>
      <div class="faq-item">
        <button class="faq-pregunta" onclick="toggleFaq(this)">
          <span><%= t('flota_faq1_p') || '¿Cómo puedo garantizar que me asignen un vehículo con espacio para mi bicicleta o tabla de surf?' %></span>
          <span class="faq-icono">+</span>
        </button>
        <div class="faq-respuesta"><%= t('flota_faq1_r') || '' %></div>
      </div>
      <div class="faq-item">
        <button class="faq-pregunta" onclick="toggleFaq(this)">
          <span><%= t('flota_faq2_p') || '¿Tienen costo adicional las sillas de bebé o elevadores infantiles?' %></span>
          <span class="faq-icono">+</span>
        </button>
        <div class="faq-respuesta"><%= t('flota_faq2_r') || '' %></div>
      </div>
      <div class="faq-item">
        <button class="faq-pregunta" onclick="toggleFaq(this)">
          <span><%= t('flota_faq3_p') || '¿El EuroTaxi permite viajar en la misma silla de ruedas sin desmontarla?' %></span>
          <span class="faq-icono">+</span>
        </button>
        <div class="faq-respuesta"><%= t('flota_faq3_r') || '' %></div>
      </div>
      <div class="faq-item">
        <button class="faq-pregunta" onclick="toggleFaq(this)">
          <span><%= t('flota_faq4_p') || '¿Puedo transportar mi bicicleta o tabla de surf?' %></span>
          <span class="faq-icono">+</span>
        </button>
        <div class="faq-respuesta"><%= t('flota_faq4_r') || '' %></div>
      </div>
      <div class="faq-item">
        <button class="faq-pregunta" onclick="toggleFaq(this)">
          <span><%= t('flota_faq5_p') || '¿Aceptan pago con tarjeta de crédito?' %></span>
          <span class="faq-icono">+</span>
        </button>
        <div class="faq-respuesta"><%= t('flota_faq5_r') || '' %></div>
      </div>
    </div>

  </div>

  <footer>
    <div class="footer-links">
      <a href="<%= lang === 'es' ? '/rutas' : '/' + lang + '/' + (palabrasPaginas.rutas || 'rutas') %>"><%= t('home_footer_rutas') || 'Rutas' %></a>
      <a href="<%= lang === 'es' ? '/destinos' : '/' + lang + '/' + (palabrasPaginas.destinos || 'destinos') %>"><%= t('home_footer_destinos') || 'Destinos' %></a>
      <a href="<%= lang === 'es' ? '/flota' : '/' + lang + '/' + (palabrasPaginas.flota || 'flota') %>"><%= t('home_footer_flota') || 'Flota' %></a>
      <a href="<%= lang === 'es' ? '/contacto' : '/' + lang + '/' + (palabrasPaginas.contacto || 'contacto') %>"><%= t('home_footer_contacto') || 'Contacto' %></a>
      <% if (lang === 'es') { %>
        <a href="/chofer/acceso/alta"><%= t('home_footer_alta_choferes') || 'Alta choferes' %></a>
        <a href="/chofer/acceso"><%= t('home_footer_acceso_choferes') || 'Acceso a choferes' %></a>
      <% } %>
      <a href="<%= lang === 'es' ? '/mi-reserva' : '/' + lang + '/' + (palabrasPaginas['mi-reserva'] || 'mi-reserva') %>"><%= t('home_footer_acceso_clientes') || 'Acceso clientes' %></a>
    </div>
    Traslados · GC — Gran Canaria
  </footer>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "TaxiService",
  "name": "Traslados GC — Transfers en Gran Canaria",
  "description": "Servicio de traslados privados intermunicipales en Gran Canaria. Flota moderna con vehículos ecológicos, EuroTaxi adaptados y transporte para equipaje deportivo.",
  "areaServed": { "@type": "AdministrativeArea", "name": "Gran Canaria" },
  "url": "<%= BASE_URL %>/flota"
}
</script>

<script>
  var langFlota = '<%= lang %>';
  var palabrasFlota = {
    flota:      '<%= palabrasPaginas.flota || "flota" %>',
    contacto:   '<%= palabrasPaginas.contacto || "contacto" %>'
  };

  var categoriasFlota = [];
  var extrasFlota = [];

  // Textos para el catálogo — vienen del servidor, no de fetch
  var txtHasta     = '<%= t("flota_catalogo_hasta") || "Hasta" %>';
  var txtPasajeros = '<%= t("flota_catalogo_pasajeros") || "pasajeros" %>';
  var txtPasajero  = '<%= t("flota_catalogo_pasajero") || "pasajero" %>';
  var txtMaletas   = '<%= t("flota_catalogo_maletas") || "maletas" %>';
  var txtReservar  = '<%= t("flota_catalogo_btn_reservar") || "Reservar" %>';
  var txtConoceMas = '<%= t("flota_catalogo_btn_conoce_mas") || "Conoce más" %>';
  var txtIntroSelector = '<%= t("flota_selector_intro") || "Según tus parámetros de búsqueda, los vehículos recomendados pueden ser estos:" %>';
  var txtSinResultado  = '<%= t("flota_selector_sin_resultado") || "No encontramos ningún vehículo que se ajuste a tu selección." %>';

  // Textos para opciones de pasajeros dinámicas
  var txtsPax = {
    <% for (var i = 1; i <= 8; i++) { %>
    '<%= i %>': '<%= t("flota_pax_" + i) || "" %>',
    <% } %>
  };

  // Cargar extras aprobados por conductores
  fetch('/api/extras-flota?lang=' + langFlota)
    .then(function(r) { return r.json(); })
    .then(function(extras) {
      extrasFlota = extras;
      var sel = document.getElementById('sel-especial');
      var aptos = extras.filter(function(e) {
        return ['C','D','E'].indexOf(e.bloque) !== -1;
      });
      if (aptos.length > 0) {
        aptos.forEach(function(e) {
          var opt = document.createElement('option');
          opt.value = e.id;
          opt.textContent = e.nombre;
          sel.appendChild(opt);
        });
      }
    })
    .catch(function() {});

  // Cargar categorías desde /api/flota
  fetch('/api/flota?lang=' + langFlota)
    .then(function(r) { return r.json(); })
    .then(function(cats) {
      categoriasFlota = cats;

      // Poblar select de pasajeros hasta el máximo disponible
      var maxPax = 0;
      cats.forEach(function(c) {
        var p = parseInt(c.capacidad_pasajeros) || 0;
        if (p > maxPax) maxPax = p;
      });
      var selPax = document.getElementById('sel-pasajeros');
      selPax.innerHTML = '';
      for (var p = 1; p <= maxPax; p++) {
        var opt = document.createElement('option');
        opt.value = p;
        opt.textContent = txtsPax[String(p)] || (p === 1 ? '1 ' + txtPasajero : p + ' ' + txtPasajeros);
        if (p === 1) opt.selected = true;
        selPax.appendChild(opt);
      }

      var grid = document.getElementById('grid-flota');
      if (!cats || cats.length === 0) {
        grid.innerHTML = '<p style="text-align:center;color:var(--texto-muted);padding:40px 0;">Próximamente más vehículos disponibles.</p>';
        return;
      }
      grid.innerHTML = cats.map(function(c) {
        var fotoHtml = c.foto
          ? '<img src="' + c.foto + '" alt="' + c.nombre + '">'
          : '<span>Sin foto</span>';
        var clsFoto = c.foto ? 'tarjeta-cat-foto' : 'tarjeta-cat-foto sin-foto';
        var desc = c.descripcion ? '<p style="font-style:italic;font-weight:700;color:var(--texto-muted);font-size:15px;margin-bottom:8px;">' + c.descripcion + '</p>' : '';
        var subtitulo = c.subtitulo ? '<p style="font-weight:700;font-size:13px;color:var(--texto-oscuro);margin-bottom:6px;">' + c.subtitulo + '</p>' : '';
        var descLarga = c.descripcion_larga ? '<p style="font-size:13px;color:var(--texto-oscuro);line-height:1.6;margin:0;">' + c.descripcion_larga.replace(/\n\n/g, '<br><br>').replace(/\n/g, '<br>') + '</p>' : '';
        var caract = '';
        if (c.caracteristicas) {
          var lineas = c.caracteristicas.split('\n').filter(function(l) { return l.trim(); });
          caract = '<p style="font-size:12px;color:var(--texto-oscuro);margin:0;line-height:1.8;">' +
            lineas.map(function(l) {
              return '<span style="margin-right:14px;white-space:nowrap;"><span style="color:#2e7d32;font-weight:700;">✓</span> ' + l.trim() + '</span>';
            }).join('') +
          '</p>';
        }
        var cap = txtHasta + ' ' + c.capacidad_pasajeros + ' ' + txtPasajeros;
        var urlReserva = langFlota !== 'es' ? '/' + langFlota + '/' : '/';
        var urlConoceMas = langFlota !== 'es'
          ? '/' + langFlota + '/' + palabrasFlota.flota + '/' + (c.isla_slug || 'gran-canaria') + '/' + c.slug_url
          : '/flota/' + (c.isla_slug || 'gran-canaria') + '/' + c.slug_url;
        return '<div class="tarjeta-cat" data-pasajeros="' + c.capacidad_pasajeros + '" data-id="' + c.id + '">'
          + '<div class="tarjeta-cat-top">'
          +   '<div>'
          +     '<div class="tarjeta-cat-nombre">' + c.nombre + '</div>'
          +     '<div class="tarjeta-cat-cap">' + cap + '</div>'
          +   '</div>'
          +   '<a href="' + urlReserva + '?categoria=' + c.id + '" class="btn-reservar-cat">' + txtReservar + '</a>'
          +   (c.slug_url ? '<a href="' + urlConoceMas + '" class="btn-reservar-cat" style="background:var(--charcoal);">' + txtConoceMas + '</a>' : '')
          + '</div>'
          + '<div class="tarjeta-cat-body">'
          +   '<div class="tarjeta-cat-desc">' + desc + subtitulo + descLarga + '</div>'
          +   '<div class="' + clsFoto + '">' + fotoHtml + '</div>'
          + '</div>'
          + (caract ? '<div class="tarjeta-cat-caract">' + caract + '</div>' : '')
          + '</div>';
      }).join('');
    })
    .catch(function() {
      document.getElementById('grid-flota').innerHTML = '<p style="text-align:center;color:var(--texto-muted);padding:40px 0;">No se pudieron cargar los vehículos.</p>';
    });

  // Selector de vehículo
  function recomendar() {
    var pasajeros = parseInt(document.getElementById('sel-pasajeros').value);
    var maletas   = parseInt(document.getElementById('sel-maletas').value);
    var especial  = document.getElementById('sel-especial').value;
    var resultado = document.getElementById('selector-resultado');

    if (categoriasFlota.length === 0) {
      resultado.innerHTML = 'Cargando vehículos... Por favor espera un momento y vuelve a intentarlo.';
      resultado.className = 'selector-resultado visible';
      return;
    }

    var ordenadas = categoriasFlota.slice().sort(function(a, b) {
      return a.capacidad_pasajeros - b.capacidad_pasajeros;
    });

    var aptas = ordenadas.filter(function(c) {
      var capMaletas = parseInt(c.capacidad_maletas) || 0;
      var okPax = c.capacidad_pasajeros >= pasajeros;
      var okMal = maletas === 0 || capMaletas >= maletas;
      return okPax && okMal;
    });
    if (aptas.length === 0) aptas = ordenadas;

    if (especial !== 'ninguno') {
      var extraId = parseInt(especial);
      var extra = extrasFlota.filter(function(e) { return e.id === extraId; })[0];
      if (extra && extra.categorias && extra.categorias.length > 0) {
        var catIds = extra.categorias.map(function(id) { return parseInt(id); });
        var aptasConExtra = aptas.filter(function(c) {
          return catIds.indexOf(c.id) !== -1;
        });
        aptas = aptasConExtra;
      }
    }

    if (aptas.length === 0) {
      resultado.innerHTML = '<p style="font-size:13px;color:var(--terracota);font-weight:600;">' + txtSinResultado + '</p>';
      resultado.className = 'selector-resultado visible';
      return;
    }
    var html = '<p style="margin-bottom:10px;font-size:13px;color:var(--texto-muted);">' + txtIntroSelector + '</p>';
    html += '<ul style="list-style:none;padding:0;margin:0;text-align:left;">';
    for (var j = 0; j < aptas.length; j++) {
      var cat = aptas[j];
      var cap = txtHasta + ' ' + cat.capacidad_pasajeros + ' ' + txtPasajeros;
      if (cat.capacidad_maletas && cat.capacidad_maletas !== '—') cap += ' · ' + cat.capacidad_maletas + ' ' + txtMaletas;
      html += '<li style="padding:8px 0;border-bottom:1px solid var(--gris-borde);">'
            + '<strong style="color:var(--texto-oscuro);font-size:14px;">' + cat.nombre + '</strong>'
            + '<span style="color:var(--texto-muted);font-size:12px;margin-left:8px;">' + cap + '</span>'
            + '</li>';
    }
    html += '</ul>';
    resultado.innerHTML = html;
    resultado.className = 'selector-resultado visible';
  }

  // FAQ acordeón
  function toggleFaq(btn) {
    var respuesta = btn.nextElementSibling;
    var abierto = btn.classList.contains('abierto');
    document.querySelectorAll('.faq-pregunta').forEach(function(b) {
      b.classList.remove('abierto');
      b.nextElementSibling.classList.remove('visible');
    });
    if (!abierto) {
      btn.classList.add('abierto');
      respuesta.classList.add('visible');
    }
  }
</script>
</body>
</html>
