<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= t('destinos_titulo') || 'Destinos' %> — Traslados GC</title>
  <link href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@500&family=Public+Sans:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/estilos.css">
  <style>
    body { background: var(--gris-fondo); color: var(--texto-oscuro); min-height: 100vh; }
    header.app {
      background: var(--charcoal);
      padding: 16px 20px;
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      border-bottom: 3px solid var(--terracota);
    }
    header.app .marca {
      font-family: 'Big Shoulders Display', sans-serif;
      font-size: 28px;
      font-weight: 500;
      color: var(--texto-claro);
      letter-spacing: 2px;
      text-decoration: none;
      text-align: center;
      justify-self: center;
    }
    header.app a.nav { color: rgba(255,255,255,0.65); text-decoration: none; font-size: 14px; }
    header.app a.nav:hover { color: #fff; }
    header.app a.nav.izquierda { justify-self: start; }
    header.app a.nav.derecha { justify-self: end; }
    @media (max-width: 560px) {
      header.app { padding: 12px 14px; }
      header.app .marca { font-size: 19px; letter-spacing: 1px; }
      header.app a.nav { font-size: 12px; }
    }

    .breadcrumbs { font-size: 13px; color: var(--texto-muted); margin-bottom: 18px; }
    .breadcrumbs a { color: var(--texto-muted); text-decoration: none; }
    .breadcrumbs a:hover { text-decoration: underline; }
    .contenido { max-width: 860px; margin: 0 auto; padding: 40px 24px 80px; }

    h1 {
      font-family: 'Big Shoulders Display', sans-serif;
      font-size: clamp(32px, 6vw, 52px);
      margin-bottom: 12px;
      text-align: center;
    }
    h1 span { color: var(--terracota); }
    .subtitulo {
      color: var(--texto-muted);
      font-size: 16px;
      font-style: italic;
      text-align: center;
      margin-bottom: 48px;
      line-height: 1.6;
    }

    .isla-bloque { margin-bottom: 48px; }
    .isla-titulo {
      font-family: 'Big Shoulders Display', sans-serif;
      font-size: 24px;
      color: var(--texto-oscuro);
      border-bottom: 2px solid var(--terracota);
      padding-bottom: 10px;
      margin-bottom: 20px;
      display: flex;
      align-items: baseline;
      gap: 10px;
    }
    .isla-titulo .isla-label {
      font-family: 'Public Sans', sans-serif;
      font-size: 11px;
      color: var(--texto-muted);
      text-transform: uppercase;
      letter-spacing: 1.5px;
      font-weight: 400;
    }

    .grid-destinos {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 14px;
    }

    .tarjeta-destino {
      background: #fff;
      border: 1px solid var(--gris-borde);
      border-radius: 12px;
      overflow: hidden;
      text-decoration: none;
      color: inherit;
      display: block;
      transition: border-color 0.15s;
    }
    .tarjeta-destino:hover { border-color: var(--terracota); }

    .td-foto {
      height: 110px;
      background: var(--charcoal);
      position: relative;
    }
    .td-foto img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    .td-zona {
      position: absolute;
      bottom: 8px;
      left: 10px;
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: rgba(255,255,255,0.5);
      font-family: 'Public Sans', sans-serif;
    }

    .td-body { padding: 12px 14px 14px; }
    .td-nombre {
      font-family: 'Big Shoulders Display', sans-serif;
      font-size: 18px;
      color: var(--texto-oscuro);
      margin-bottom: 4px;
      line-height: 1.1;
    }
    .td-resena { font-size: 12px; color: var(--texto-muted); line-height: 1.4; margin-top: 4px; }

    .bloque-proximamente {
      margin-top: 24px;
      padding: 28px 24px;
      background: #fff;
      border: 1px solid var(--gris-borde);
      border-radius: 12px;
      text-align: center;
    }
    .prox-titulo {
      font-family: 'Big Shoulders Display', sans-serif;
      font-size: 22px;
      color: var(--texto-muted);
      margin-bottom: 8px;
    }
    .prox-sub {
      font-size: 13px;
      color: var(--texto-muted);
      font-style: italic;
    }

    .sin-destinos {
      text-align: center;
      color: var(--texto-muted);
      font-size: 14px;
      padding: 40px 0;
    }

    @media (max-width: 600px) {
      .contenido { padding: 24px 16px 60px; }
      .grid-destinos { grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 10px; }
    }

    footer { text-align: center; padding: 30px; color: var(--texto-muted); font-size: 13px; }
    footer a { color: var(--texto-muted); text-decoration: none; margin: 0 12px; font-size: 13px; }
    footer a:hover { color: var(--texto-oscuro); }
    .footer-links { margin-bottom: 12px; }
  </style>
</head>
<body>
  <header class="app">
    <a href="<%= lang === 'es' ? '/' : '/' + lang + '/' %>" class="nav izquierda"><%= t('nav_inicio_flecha') || '← Inicio' %></a>
    <a href="<%= lang === 'es' ? '/' : '/' + lang + '/' %>" class="marca">TRASLADOS · GC</a>
    <a href="<%= lang === 'es' ? '/contacto' : '/' + lang + '/' + (palabrasPaginas.contacto || 'contacto') %>" class="nav derecha"><%= t('nav_contacto') || 'Contacto' %></a>
  </header>

  <div class="contenido">
    <nav class="breadcrumbs">
      <a href="<%= lang === 'es' ? '/' : '/' + lang + '/' %>"><%= t('nav_inicio') || 'Inicio' %></a>
      <span> › </span>
      <span><%= t('home_footer_destinos') || 'Destinos' %></span>
    </nav>

    <h1><%= t('destinos_titulo') || 'Destinos' %></h1>
    <p class="subtitulo"><%= t('destinos_subtitulo') || 'Descubre los destinos más solicitados de Gran Canaria' %></p>

    <% var nombresIslas = Object.keys(porIsla); %>
    <% if (nombresIslas.length === 0) { %>
      <p class="sin-destinos">Próximamente los destinos disponibles.</p>
    <% } else { %>
      <% nombresIslas.forEach(function(isla) { %>
        <% var destinos = porIsla[isla]; %>
        <div class="isla-bloque">
          <div class="isla-titulo">
            <%= t('destinos_nombre_isla') || isla %>
            <span class="isla-label"><%= t('destinos_palabra_isla') || 'Isla' %></span>
          </div>
          <div class="grid-destinos">
            <% destinos.forEach(function(dest) { %>
              <%
                var urlDestino;
                if (lang === 'es') {
                  urlDestino = '/es/destino/' + dest.isla_slug + '/' + dest.slug;
                } else {
                  urlDestino = '/' + lang + '/' + palabraDestino + '/' + dest.isla_slug + '/' + dest.slug;
                }
              %>
              <a href="<%= urlDestino %>" class="tarjeta-destino">
                <div class="td-foto">
                  <% if (dest.foto_cabecera_id) { %>
                    <img src="/destino-foto/<%= dest.foto_cabecera_id %>" alt="<%= dest.nombre %>">
                  <% } %>
                  <% if (dest.zona) { %>
                    <span class="td-zona"><%= dest.zona %></span>
                  <% } %>
                </div>
                <div class="td-body">
                  <div class="td-nombre"><%= dest.nombre %></div>
                  <% if (dest.resena_breve) { %>
                    <div class="td-resena"><%= dest.resena_breve %></div>
                  <% } %>
                </div>
              </a>
            <% }); %>
          </div>
        </div>
      <% }); %>
    <% } %>

    <div class="bloque-proximamente">
      <div class="prox-titulo"><%= t('destinos_proximamente_titulo') || 'Próximamente · Otras islas' %></div>
      <p class="prox-sub"><%= t('destinos_proximamente_subtitulo') || 'Estamos ampliando el servicio al resto del archipiélago. Muy pronto, más islas.' %></p>
    </div>
  </div>

  <footer>
    <div class="footer-links">
      <a href="<%= lang === 'es' ? '/rutas' : '/' + lang + '/' + (palabrasPaginas.rutas || 'rutas') %>"><%= t('home_footer_rutas') || 'Rutas' %></a>
      <a href="<%= lang === 'es' ? '/destinos' : '/' + lang + '/' + (palabrasPaginas.destinos || 'destinos') %>"><%= t('home_footer_destinos') || 'Destinos' %></a>
      <a href="<%= lang === 'es' ? '/flota' : '/' + lang + '/' + (palabrasPaginas.flota || 'flota') %>"><%= t('home_footer_flota') || 'Flota' %></a>
      <a href="<%= lang === 'es' ? '/contacto' : '/' + lang + '/' + (palabrasPaginas.contacto || 'contacto') %>"><%= t('home_footer_contacto') || 'Contacto' %></a>
      <% if (lang === 'es') { %>
        <a href="/chofer/acceso/alta"><%= t('home_footer_alta_choferes') || 'Alta choferes' %></a>
        <a href="/chofer/acceso"><%= t('home_footer_acceso_choferes') || 'Acceso a choferes' %></a>
      <% } %>
      <a href="<%= lang === 'es' ? '/mi-reserva' : '/' + lang + '/' + (palabrasPaginas['mi-reserva'] || 'mi-reserva') %>"><%= t('home_footer_acceso_clientes') || 'Acceso clientes' %></a>
    </div>
    Traslados · GC — Gran Canaria
  </footer>
</body>
</html>
