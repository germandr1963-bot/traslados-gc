<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= dest.meta_title || (dest.nombre + ' — Traslados GC') %></title>
  <% if (dest.meta_description) { %>
  <meta name="description" content="<%= dest.meta_description %>">
  <% } %>
  <link href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@500&family=Public+Sans:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/estilos.css">
  <style>
    body { background: var(--gris-fondo); color: var(--texto-oscuro); min-height: 100vh; }

    header.app {
      background: var(--charcoal);
      padding: 16px 20px;
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      border-bottom: 3px solid var(--terracota);
    }
    header.app .marca {
      font-family: 'Big Shoulders Display', sans-serif;
      font-size: 28px;
      font-weight: 500;
      color: var(--texto-claro);
      letter-spacing: 2px;
      text-decoration: none;
      text-align: center;
      justify-self: center;
    }
    header.app a.nav { color: rgba(255,255,255,0.65); text-decoration: none; font-size: 14px; }
    header.app a.nav:hover { color: #fff; }
    header.app a.nav.izquierda { justify-self: start; }
    header.app a.nav.derecha { justify-self: end; }
    @media (max-width: 560px) {
      header.app { padding: 12px 14px; }
      header.app .marca { font-size: 19px; letter-spacing: 1px; }
      header.app a.nav { font-size: 12px; }
    }

    .breadcrumbs { font-size: 13px; color: var(--texto-muted); margin-bottom: 18px; }
    .breadcrumbs a { color: var(--texto-muted); text-decoration: none; }
    .breadcrumbs a:hover { text-decoration: underline; }
    .contenido { max-width: 860px; margin: 0 auto; padding: 40px 24px 80px; }

    /* Imagen cabecera */
    .foto-cabecera {
      width: 100%;
      height: 400px;
      background: var(--charcoal);
      border-radius: 12px;
      overflow: hidden;
      margin-bottom: 32px;
    }
    .foto-cabecera img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    /* Título */
    h1 {
      font-family: 'Big Shoulders Display', sans-serif;
      font-size: clamp(32px, 6vw, 52px);
      margin-bottom: 24px;
      line-height: 1.1;
      text-align: center;
    }

    /* Texto descriptivo */
    .texto-destino {
      font-size: 15px;
      line-height: 1.75;
      color: var(--texto-oscuro);
      margin-bottom: 48px;
    }
    .texto-destino h2 { font-family: 'Big Shoulders Display', sans-serif; font-size: 24px; margin: 28px 0 10px; }
    .texto-destino h2:first-of-type { font-size: 32px; text-align: center; color: #b02020; margin-bottom: 18px; }
    .texto-destino h3 { font-family: 'Big Shoulders Display', sans-serif; font-size: 20px; margin: 22px 0 8px; }
    .texto-destino p  { margin: 0 0 14px; }
    .texto-destino ul { padding-left: 20px; margin: 0 0 14px; }
    .texto-destino li { margin-bottom: 6px; }

    /* Tres fotos */
    .fotos-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 14px;
      margin-bottom: 48px;
    }
    .foto-item {
      height: 220px;
      background: var(--charcoal);
      border-radius: 10px;
      overflow: hidden;
    }
    .foto-item img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    /* CTA reserva */
    .cta-destino {
      text-align: center;
      margin: 0 0 48px;
    }
    .cta-destino-btn {
      display: inline-block;
      background: var(--terracota);
      color: #fff;
      text-decoration: none;
      font-family: 'Big Shoulders Display', sans-serif;
      font-size: 20px;
      letter-spacing: 1px;
      padding: 16px 40px;
      border-radius: 8px;
      transition: opacity 0.2s;
    }
    .cta-destino-btn:hover { opacity: 0.88; }

    footer { text-align: center; padding: 30px; color: var(--texto-muted); font-size: 13px; }
    footer a { color: var(--texto-muted); text-decoration: none; margin: 0 12px; font-size: 13px; }
    footer a:hover { color: var(--texto-oscuro); }
    .footer-links { margin-bottom: 12px; }

    @media (max-width: 600px) {
      .contenido { padding: 24px 16px 60px; }
      .foto-cabecera { height: 220px; border-radius: 8px; }
      .fotos-grid { grid-template-columns: 1fr; }
      .foto-item { height: 200px; }
    }
  </style>
</head>
<body>
  <header class="app">
    <a href="<%= urlDestinos %>" class="nav izquierda"><%= t('nav_destinos_flecha') || '← Destinos' %></a>
    <a href="<%= lang === 'es' ? '/' : '/' + lang + '/' %>" class="marca">TRASLADOS · GC</a>
    <a href="<%= lang === 'es' ? '/contacto' : '/' + lang + '/' + (palabrasPaginas.contacto || 'contacto') %>" class="nav derecha"><%= t('nav_contacto') || 'Contacto' %></a>
  </header>

  <div class="contenido">
    <nav class="breadcrumbs">
      <a href="<%= lang === 'es' ? '/' : '/' + lang + '/' %>"><%= t('nav_inicio') || 'Inicio' %></a>
      <span> › </span>
      <a href="<%= urlDestinos %>"><%= t('home_footer_destinos') || 'Destinos' %></a>
      <span> › </span>
      <span><%= dest.nombre %></span>
    </nav>

    <!-- Foto cabecera -->
    <div class="foto-cabecera">
      <% if (dest.foto_cabecera_id) { %>
        <img src="/destino-foto/<%= dest.foto_cabecera_id %>" alt="<%= dest.nombre %>">
      <% } %>
    </div>

    <!-- Título -->
    <h1><%= dest.nombre %></h1>

    <!-- Texto descriptivo -->
    <% if (dest.texto_descripcion) { %>
      <div class="texto-destino"><%- dest.texto_descripcion %></div>
    <% } %>

    <!-- CTA — enlace al buscador con el destino preseleccionado -->
    <% if (t('destino_cta_texto')) { %>
      <div class="cta-destino">
        <a href="<%= urlCta %>" class="cta-destino-btn"><%= t('destino_cta_texto') %> <%= dest.nombre %></a>
      </div>
    <% } %>

    <!-- Tres fotos adicionales -->
    <% if (fotos && fotos.length > 0) { %>
      <div class="fotos-grid">
        <% fotos.forEach(function(f) { %>
          <div class="foto-item">
            <img src="/destino-foto/<%= f.id %>" alt="<%= f.alt_texto || dest.nombre %>">
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>

  <footer>
    <div class="footer-links">
      <a href="<%= lang === 'es' ? '/rutas' : '/' + lang + '/' + (palabrasPaginas.rutas || 'rutas') %>"><%= t('home_footer_rutas') || 'Rutas' %></a>
      <a href="<%= lang === 'es' ? '/destinos' : '/' + lang + '/' + (palabrasPaginas.destinos || 'destinos') %>"><%= t('home_footer_destinos') || 'Destinos' %></a>
      <a href="<%= lang === 'es' ? '/flota' : '/' + lang + '/' + (palabrasPaginas.flota || 'flota') %>"><%= t('home_footer_flota') || 'Flota' %></a>
      <a href="<%= lang === 'es' ? '/contacto' : '/' + lang + '/' + (palabrasPaginas.contacto || 'contacto') %>"><%= t('home_footer_contacto') || 'Contacto' %></a>
      <% if (lang === 'es') { %>
        <a href="/chofer/acceso/alta"><%= t('home_footer_alta_choferes') || 'Alta choferes' %></a>
        <a href="/chofer/acceso"><%= t('home_footer_acceso_choferes') || 'Acceso a choferes' %></a>
      <% } %>
      <a href="<%= lang === 'es' ? '/mi-reserva' : '/' + lang + '/' + (palabrasPaginas['mi-reserva'] || 'mi-reserva') %>"><%= t('home_footer_acceso_clientes') || 'Acceso clientes' %></a>
    </div>
    Traslados · GC — Gran Canaria
  </footer>
</body>
</html>
