<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= t('rest_1_titulo_pestana') %></title>
  <link href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@500&family=Public+Sans:wght@400;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/estilos.css">
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Public Sans', 'Segoe UI', Arial, sans-serif;
      background: var(--gris-fondo);
      min-height: 100vh;
    }
    header.app {
      background: var(--charcoal);
      padding: 16px 20px;
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      border-bottom: 3px solid var(--terracota);
    }
    header.app .marca {
      font-family: 'Big Shoulders Display', sans-serif;
      font-size: 28px;
      font-weight: 500;
      color: var(--texto-claro);
      letter-spacing: 2px;
      text-decoration: none;
      text-align: center;
      justify-self: center;
    }
    header.app a.nav { color: rgba(255,255,255,0.65); text-decoration: none; font-size: 14px; }
    header.app a.nav:hover { color: #fff; }
    header.app a.nav.izquierda { justify-self: start; }
    header.app a.nav.derecha { justify-self: end; }
    @media (max-width: 560px) {
      header.app { padding: 12px 14px; }
      header.app .marca { font-size: 19px; letter-spacing: 1px; }
      header.app a.nav { font-size: 12px; }
    }
    main {
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 40px 20px 60px;
    }
    h1 { font-family: 'Big Shoulders Display', sans-serif; font-size: clamp(32px, 6vw, 52px); color: var(--texto-oscuro); margin-bottom: 12px; }
    .subtitulo { color: var(--texto-muted); font-size: 19px; font-style: italic; letter-spacing: 0.3px; margin-bottom: 28px; line-height: 1.6; text-align: center; }
    .card {
      background: #fff;
      border: 1px solid var(--gris-borde);
      border-radius: 12px;
      padding: 20px;
      width: 100%;
      max-width: 520px;
    }
    .logo { text-align: center; margin-bottom: 32px; }
    .logo h1 { font-size: 22px; color: #C1502E; font-weight: 700; letter-spacing: 1px; margin-bottom: 0; }
    .logo p { font-size: 13px; color: #888; margin-top: 4px; }
    label { display: block; font-size: 13px; font-weight: 600; color: #444; margin-bottom: 5px; }
    input {
      width: 100%;
      border: 1.5px solid #ddd;
      border-radius: 8px;
      padding: 10px 14px;
      font-size: 15px;
      color: #2c2c2c;
      margin-bottom: 18px;
      transition: border-color 0.2s;
      font-family: inherit;
    }
    input:focus { outline: none; border-color: #C1502E; }
    .boton {
      width: 100%;
      background: #C1502E;
      color: #fff;
      border: none;
      border-radius: 8px;
      padding: 12px;
      font-size: 15px;
      font-weight: 700;
      cursor: pointer;
    }
    .boton:disabled { opacity: 0.6; cursor: not-allowed; }
    .error { display: none; background: #fbe6e6; color: #8a2424; border-radius: 8px; padding: 10px 14px; font-size: 13px; margin-bottom: 16px; }
    .ok { display: none; background: #e6f7ee; color: #1c6e44; border-radius: 8px; padding: 20px; font-size: 14px; text-align: center; line-height: 1.6; }
    .oculto { display: none; }
    footer { text-align: center; padding: 30px; color: var(--texto-muted); font-size: 13px; }
  </style>
</head>
<body>
  <header class="app">
    <a href="<%= lang === 'es' ? '/' : '/' + lang + '/' %>" class="nav izquierda"><%= t('nav_inicio') || 'Inicio' %></a>
    <a href="<%= lang === 'es' ? '/' : '/' + lang + '/' %>" class="marca">TRASLADOS · GC</a>
    <a href="<%= lang === 'es' ? '/contacto' : '/' + lang + '/' + (palabrasPaginas.contacto || 'contacto') %>" class="nav derecha"><%= t('nav_contacto') || 'Contacto' %></a>
  </header>
  <main>
  <h1><%= t('rest_2_titulo') %></h1>
  <p class="subtitulo"><%= t('rest_3_subtitulo') %></p>
  <div class="card">

    <div id="pantalla-form">
      <div id="error-msg" class="error"></div>
      <label for="pwd1"><%= t('rest_4_label_nueva') %></label>
      <input type="password" id="pwd1" placeholder="<%= t('rest_5_placeholder_nueva') %>">
      <label for="pwd2"><%= t('rest_6_label_repite') %></label>
      <input type="password" id="pwd2" placeholder="<%= t('rest_7_placeholder_repite') %>">
      <button class="boton" id="btn-guardar" onclick="guardar()"><%= t('rest_8_boton') %></button>
    </div>

    <div id="pantalla-ok" class="ok">
      <%= t('rest_10_ok') %>
    </div>
  </div>
  </main>

  <footer>
    <div style="margin-bottom:12px;">
      <a href="<%= lang === 'es' ? '/rutas' : '/' + lang + '/' + (palabrasPaginas.rutas || 'rutas') %>" style="color:var(--texto-muted);text-decoration:none;margin:0 12px;font-size:13px;"><%= t('home_footer_rutas') || 'Rutas' %></a>
      <a href="<%= lang === 'es' ? '/destinos' : '/' + lang + '/' + (palabrasPaginas.destinos || 'destinos') %>" style="color:var(--texto-muted);text-decoration:none;margin:0 12px;font-size:13px;"><%= t('home_footer_destinos') || 'Destinos' %></a>
      <a href="<%= lang === 'es' ? '/flota' : '/' + lang + '/' + (palabrasPaginas.flota || 'flota') %>" style="color:var(--texto-muted);text-decoration:none;margin:0 12px;font-size:13px;"><%= t('home_footer_flota') || 'Flota' %></a>
      <a href="<%= lang === 'es' ? '/contacto' : '/' + lang + '/' + (palabrasPaginas.contacto || 'contacto') %>" style="color:var(--texto-muted);text-decoration:none;margin:0 12px;font-size:13px;"><%= t('home_footer_contacto') || 'Contacto' %></a>
      <% if (lang === 'es') { %>
      <a href="/chofer/acceso/alta" style="color:var(--texto-muted);text-decoration:none;margin:0 12px;font-size:13px;"><%= t('home_footer_alta_choferes') || 'Alta choferes' %></a>
      <a href="/chofer/acceso" style="color:var(--texto-muted);text-decoration:none;margin:0 12px;font-size:13px;"><%= t('home_footer_acceso_choferes') || 'Acceso a choferes' %></a>
      <% } %>
      <a href="<%= lang === 'es' ? '/mi-reserva' : '/' + lang + '/' + (palabrasPaginas['mi-reserva'] || 'mi-reserva') %>" style="color:var(--texto-muted);text-decoration:none;margin:0 12px;font-size:13px;"><%= t('home_footer_acceso_clientes') || 'Acceso clientes' %></a>
    </div>
    Traslados · GC — Gran Canaria
  </footer>

  <script>
    // (02/10/2026) Textos en el idioma de la página (Admin → Idiomas → Textos de interfaz → "Restablecer contraseña")
    var TX = <%- JSON.stringify({
      boton: t('rest_8_boton'), guardando: t('rest_9_guardando'),
      errEnlace: t('rest_11_err_enlace'), errMinimo: t('rest_12_err_minimo'),
      errNoCoinciden: t('rest_13_err_no_coinciden'), errConexion: t('rest_14_err_conexion')
    }).replace(/</g, '\\u003c') %>;
    var LANG = '<%= lang %>';
    var URL_MI_RESERVA = <%- JSON.stringify(urlMiReserva).replace(/</g, '\\u003c') %>;
    var params = new URLSearchParams(window.location.search);
    var token = params.get('token') || '';
    var tipo = params.get('tipo') || '';

    if (!token || !tipo) {
      document.getElementById('error-msg').textContent = TX.errEnlace;
      document.getElementById('error-msg').style.display = 'block';
      document.getElementById('btn-guardar').disabled = true;
    }

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Enter') guardar();
    });

    function guardar() {
      var p1 = document.getElementById('pwd1').value;
      var p2 = document.getElementById('pwd2').value;
      var err = document.getElementById('error-msg');
      err.style.display = 'none';

      if (!p1 || p1.length < 6) { err.textContent = TX.errMinimo; err.style.display = 'block'; return; }
      if (p1 !== p2) { err.textContent = TX.errNoCoinciden; err.style.display = 'block'; return; }

      var btn = document.getElementById('btn-guardar');
      btn.disabled = true; btn.textContent = TX.guardando;

      fetch('/api/restablecer-password', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ token: token, password_nueva: p1, lang: LANG })
      })
      .then(function(r) { return r.json(); })
      .then(function(d) {
        if (d.error) {
          err.textContent = d.error;
          err.style.display = 'block';
          btn.disabled = false; btn.textContent = TX.boton;
          return;
        }
        document.getElementById('pantalla-form').classList.add('oculto');
        document.getElementById('pantalla-ok').style.display = 'block';
        setTimeout(function() {
          window.location.href = tipo === 'chofer' ? '/chofer/acceso' : URL_MI_RESERVA;
        }, 2500);
      })
      .catch(function() {
        err.textContent = TX.errConexion;
        err.style.display = 'block';
        btn.disabled = false; btn.textContent = TX.boton;
      });
    }
  </script>
</body>
</html>
