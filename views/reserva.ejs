// Las píldoras de idioma conservan la ruta y categoría elegidas
document.addEventListener('DOMContentLoaded', function() {
  if (window.location.search) {
    document.querySelectorAll('.lang-pill').forEach(function(a) { a.href += window.location.search; });
  }
});

// ── Variables ───────────────────────────────────────────────────────────────
var extrasData = [];
var extrasSeleccionados = [];
var precioEstimado = null;
var categoriaNombre = '';
var pasoActual = 1;
var pnrGenerado = '';

function generarPNR() {
  var letras = 'ABCDEFGHJKLMNPQRSTUVWXYZ';
  var nums = '0123456789';
  var l = function(){ return letras[Math.floor(Math.random() * letras.length)]; };
  var n = function(){ return nums[Math.floor(Math.random() * nums.length)]; };
  return l() + l() + l() + n() + n() + n();
}

var params = new URLSearchParams(window.location.search);
var paramOrigen = params.get('desde') || '';
var paramDestino = params.get('hasta') || '';
// Nombres para MOSTRAR al visitante (traducidos al cargar las rutas).
// Internamente y hacia el sistema siempre viajan los nombres en español.
var ORIGEN_MOSTRAR = paramOrigen;
var DESTINO_MOSTRAR = paramDestino;
var paramCategoriaId = params.get('categoria_id') || '';

// Detectar tipo de origen y destino
var oL = paramOrigen.toLowerCase();
var dL = paramDestino.toLowerCase();
var origenEsAero    = oL.indexOf('aeropuerto') !== -1;
var origenEsPuerto  = !origenEsAero && oL.indexOf('puerto') !== -1;
var destinoEsAero   = dL.indexOf('aeropuerto') !== -1;
var destinoEsPuerto = !destinoEsAero && dL.indexOf('puerto') !== -1;
var tocaAeropuerto  = origenEsAero || destinoEsAero;
var tocaPuerto      = origenEsPuerto || destinoEsPuerto;

// ── Inicialización ──────────────────────────────────────────────────────────
(function init() {
  // Sin ruta elegida (p. ej. llegando desde "+ Nueva reserva"):
  // mostrar el panel de ruta y ocultar el formulario hasta que elija
  if (!paramOrigen || !paramDestino || !paramCategoriaId) {
    document.getElementById('panel-ruta').style.display = 'block';
    document.querySelectorAll('.paso').forEach(function(p){ p.style.display = 'none'; });
    cargarRutas();
    cargarCategorias();
    return;
  }

  // Tarjeta resumen
  if (paramOrigen && paramDestino) {
    document.getElementById('tbl-origen').textContent = paramOrigen;
    document.getElementById('tbl-destino').textContent = paramDestino;
    document.getElementById('tarjeta-traslado').style.display = 'flex';
  }

  // Mostrar campos correctos según origen
  if (origenEsAero) {
    mostrar('bloque-aero-origen');
  } else if (origenEsPuerto) {
    mostrar('bloque-puerto-origen');
  } else {
    mostrar('bloque-hora-recogida');
    mostrar('bloque-dir-origen');
  }

  // Mostrar campo dirección destino solo si no es aeropuerto ni puerto
  if (!destinoEsAero && !destinoEsPuerto) {
    mostrar('bloque-dir-destino');
  }

  // Campos del paso 2 según tipo de trayecto
  if (origenEsAero || origenEsPuerto) {
    mostrar('bloque-pasaporte');
    mostrar('bloque-pasaporte-otra');
  }

  // Fecha mínima hoy
  document.getElementById('fecha').min = new Date().toISOString().split('T')[0];

  // Cargar precio y categoría
  if (paramCategoriaId && paramOrigen && paramDestino) {
    fetch('/api/rutas?lang=' + LANG).then(function(r){ return r.json(); }).then(function(rutas){
      var ruta = rutas.find(function(r){ return r.origen === paramOrigen && r.destino === paramDestino; });
      if (!ruta) return;
      if (ruta.origen_traducido) { ORIGEN_MOSTRAR = ruta.origen_traducido; document.getElementById('tbl-origen').textContent = ORIGEN_MOSTRAR; }
      if (ruta.destino_traducido) { DESTINO_MOSTRAR = ruta.destino_traducido; document.getElementById('tbl-destino').textContent = DESTINO_MOSTRAR; }
      fetch('/api/precio?ruta_id=' + ruta.id + '&categoria_id=' + paramCategoriaId)
        .then(function(r){ return r.json(); })
        .then(function(data){
          if (!data.a_consultar) {
            precioEstimado = data.precio;
            document.getElementById('tbl-precio').textContent = Number(data.precio).toFixed(0) + ' €';
            document.getElementById('tbl-badge').style.display = 'inline-block';
          } else {
            document.getElementById('tbl-precio').textContent = '';
            document.getElementById('tbl-badge').style.display = 'none';
          }
        });
    });
    fetch('/api/categorias?lang=' + LANG).then(function(r){ return r.json(); }).then(function(cats){
      var cat = cats.find(function(c){ return String(c.id) === String(paramCategoriaId); });
      if (!cat) return;
      categoriaNombre = cat.nombre_traducido || cat.nombre;
      document.getElementById('tbl-categoria').textContent = (cat.nombre_traducido || cat.nombre) + ' · ' + cat.capacidad_pasajeros + ' ' + TXT.paxSufijo;
      var maxPax = parseInt(cat.capacidad_pasajeros) || 8;
      var sel = document.getElementById('num-pasajeros');
      sel.innerHTML = '';
      for (var i = 1; i <= maxPax; i++) {
        var opt = document.createElement('option');
        opt.value = i; opt.textContent = i + ' ' + (i === 1 ? TXT.paxSingular : TXT.paxPlural);
        sel.appendChild(opt);
      }
    });
  } else {
    // Sin categoría: pasajeros por defecto
    var sel = document.getElementById('num-pasajeros');
    sel.innerHTML = '';
    for (var i = 1; i <= 8; i++) {
      var opt = document.createElement('option');
      opt.value = i; opt.textContent = i + ' ' + (i === 1 ? TXT.paxSingular : TXT.paxPlural);
      sel.appendChild(opt);
    }
  }

  // Cargar extras
  fetch('/api/extras-publicos?lang=' + LANG).then(function(r){ return r.json(); }).then(function(extras){
    extrasData = extras;
    var lista = document.getElementById('lista-extras');
    if (!extras.length) {
      lista.innerHTML = '<p style="color:var(--texto-muted);font-size:13px;">' + TXT.sinExtras + '</p>';
      return;
    }
    lista.innerHTML = extras.map(function(ex){
      return '<div class="extra-item" id="extra-' + ex.id + '" onclick="toggleExtra(' + ex.id + ')">' +
        '<div class="extra-check" id="check-' + ex.id + '"></div>' +
        '<span class="extra-nombre">' + (ex.nombre_traducido || ex.nombre) + '</span>' +
        '<span class="extra-precio">' + Number(ex.precio).toFixed(2) + ' €</span>' +
      '</div>';
    }).join('');
  });

  // Si el cliente ya tiene sesión abierta, prellenar sus datos de contacto y mostrar banner
  fetch('/api/cliente/sesion').then(function(r){ return r.json(); }).then(function(s){
    if (!s.autenticado) return;
    fetch('/api/cliente/mis-datos').then(function(r){ return r.json(); }).then(function(d){
      if (!d.nombre_cliente) return;
      // Mostrar banner portal del cliente (nombre + primer apellido)
      var banner = document.getElementById('banner-portal-cliente');
      var nombreBanner = document.getElementById('banner-nombre-cliente');
      if (banner && nombreBanner) {
        var parteNombre = (d.nombre_cliente || '').trim().split(/\s+/);
        var nombreCorto = parteNombre.length >= 2 ? parteNombre[0] + ' ' + parteNombre[1] : parteNombre[0] || '';
        nombreBanner.textContent = TXT.bannerHola.replace('{nombre}', nombreCorto);
        banner.style.display = 'block';
      }
      document.getElementById('contacto-nombre').value = d.nombre_cliente;
      document.getElementById('contacto-email').value = d.email_cliente;
      var tel = (d.telefono_cliente || '').trim();
      var partes = tel.split(' ');
      if (partes.length > 1 && partes[0].indexOf('+') === 0) {
        var prefijoSel = document.getElementById('telefono-prefijo');
        var existe = Array.from(prefijoSel.options).some(function(o){ return o.value === partes[0]; });
        if (existe) prefijoSel.value = partes[0];
        document.getElementById('telefono-numero').value = partes.slice(1).join(' ');
      } else {
        document.getElementById('telefono-numero').value = tel;
      }
      // Con sesión: los datos del titular salen por omisión y no son editables
      document.getElementById('nota-datos-cuenta').style.display = 'block';
      ['contacto-nombre','telefono-numero','contacto-email'].forEach(function(id){
        var el = document.getElementById(id);
        el.readOnly = true;
        el.style.background = 'var(--gris-fondo)';
        el.style.color = 'var(--texto-muted)';
      });
      var pref = document.getElementById('telefono-prefijo');
      pref.disabled = true;
      pref.style.background = 'var(--gris-fondo)';
      pref.style.color = 'var(--texto-muted)';
    });
  });
})();

function mostrar(id) { document.getElementById(id).style.display = 'block'; }

// ── Panel de ruta (espejo del buscador de la portada) ───────────────────────
var rutasDisponibles = [];
var categoriasDisponibles = [];

function poblarSelect(select, valores) {
  // valores: lista de objetos { valor, etiqueta } — valor interno en español,
  // etiqueta traducida para el visitante (mismo patrón que la portada)
  select.innerHTML = '<option value="">' + TXT.selecciona + '</option>';
  valores.forEach(function (v) {
    var opt = document.createElement('option');
    opt.value = v.valor;
    opt.textContent = v.etiqueta;
    select.appendChild(opt);
  });
}

function cargarRutas() {
  fetch('/api/rutas?lang=' + LANG).then(function (r) { return r.json(); }).then(function (rutas) {
    rutasDisponibles = rutas;
    var vistosO = {}, origenes = [];
    var vistosD = {}, destinos = [];
    rutas.forEach(function (r) {
      if (!vistosO[r.origen]) { vistosO[r.origen] = true; origenes.push({ valor: r.origen, etiqueta: r.origen_traducido || r.origen }); }
      if (!vistosD[r.destino]) { vistosD[r.destino] = true; destinos.push({ valor: r.destino, etiqueta: r.destino_traducido || r.destino }); }
    });
    poblarSelect(document.getElementById('desde'), origenes);
    poblarSelect(document.getElementById('hasta'), destinos);
    if (rutas.length === 0) {
      document.getElementById('resultado-precio').textContent = TXT.sinRutas;
    }
  });
}

function cargarCategorias() {
  fetch('/api/categorias?lang=' + LANG).then(function (r) { return r.json(); }).then(function (categorias) {
    categoriasDisponibles = categorias;
    // No cargamos todas de golpe — se filtran al elegir ruta
    actualizarCategoriasSegunRuta();
  });
}

function actualizarCategoriasSegunRuta() {
  var desdeVal = document.getElementById('desde').value;
  var hastaVal = document.getElementById('hasta').value;
  var select = document.getElementById('categoria');
  var valorActual = select.value;

  // Buscar la ruta seleccionada (en ambas direcciones)
  var ruta = rutasDisponibles.find(function (r) { return r.origen === desdeVal && r.destino === hastaVal; })
          || rutasDisponibles.find(function (r) { return r.origen === hastaVal && r.destino === desdeVal; });

  select.innerHTML = '<option value="">' + TXT.selecciona + '</option>';

  if (!ruta || !desdeVal || !hastaVal) {
    // Sin ruta seleccionada — no mostrar categorías
    return;
  }

  // Filtrar solo las categorías que tienen precio para esta ruta
  var categoriasRuta = categoriasDisponibles.filter(function (c) {
    return ruta.categorias_con_precio && ruta.categorias_con_precio.indexOf(c.id) !== -1;
  });

  categoriasRuta.forEach(function (c) {
    var opt = document.createElement('option');
    opt.value = c.id;
    opt.textContent = (c.nombre_traducido || c.nombre) + ' (' + c.capacidad_pasajeros + ' ' + TXT.paxSufijo + ')';
    if (String(c.id) === String(valorActual)) opt.selected = true;
    select.appendChild(opt);
  });

  // Limpiar resultado si la categoría ya no es válida
  if (valorActual && !categoriasRuta.find(function(c) { return String(c.id) === String(valorActual); })) {
    document.getElementById('resultado-precio').innerHTML = '';
  }
}

function verPrecio() {
  var desdeVal = document.getElementById('desde').value;
  var hastaVal = document.getElementById('hasta').value;
  var categoriaId = document.getElementById('categoria').value;
  var resultado = document.getElementById('resultado-precio');

  if (!desdeVal || !hastaVal || !categoriaId) {
    resultado.innerHTML = '<div class="resultado-vacio">' + TXT.eligeRuta + '</div>';
    return;
  }

  var ruta = rutasDisponibles.find(function (r) { return r.origen === desdeVal && r.destino === hastaVal; })
          || rutasDisponibles.find(function (r) { return r.origen === hastaVal && r.destino === desdeVal; });
  var categoriaSelect = document.getElementById('categoria');
  var categoriaTexto = categoriaSelect.options[categoriaSelect.selectedIndex].text;

  // Buscar datos de la categoría (foto, pax, maletas)
  var catData = categoriasDisponibles.find(function (c) { return String(c.id) === String(categoriaId); });

  if (!ruta) {
    resultado.innerHTML = '<div class="resultado-vacio">' + TXT.rutaAConsultar + '</div>';
    return;
  }

  fetch('/api/precio?ruta_id=' + ruta.id + '&categoria_id=' + categoriaId)
    .then(function (r) { return r.json(); })
    .then(function (data) {
      var fotoHtml = catData && catData.foto
        ? '<img class="tarjeta-resultado-foto" src="' + catData.foto + '" alt="' + (catData.nombre_traducido || catData.nombre || '') + '">'
        : '<div class="tarjeta-resultado-foto-placeholder">🚗</div>';

      var paxHtml = catData
        ? '<div class="tarjeta-resultado-dato">' +
            '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#D9A441" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>' +
            catData.capacidad_pasajeros + ' ' + TXT.paxSufijo +
          '</div>' +
          (catData.capacidad_maletas
            ? '<div class="tarjeta-resultado-dato">' +
                '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#D9A441" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/><line x1="12" y1="12" x2="12" y2="16"/><line x1="10" y1="14" x2="14" y2="14"/></svg>' +
                (catData.capacidad_maletas_traducida || catData.capacidad_maletas) +
              '</div>'
            : '')
        : '';

      var precioHtml = data.a_consultar
        ? '<span class="precio precio-grande" style="font-size:22px;">' + TXT.aConsultar + '</span>'
        : '<span class="precio precio-grande">' + Number(data.precio).toFixed(0) + ' €</span>';

      var botonHtml = '<button class="boton-reservar" onclick="irAReserva()">' + TXT.botonReservar + '</button>';

      resultado.innerHTML =
        '<div class="tarjeta-resultado">' +
          fotoHtml +
          '<div class="tarjeta-resultado-info">' +
            '<div class="tarjeta-resultado-nombre">' + (catData ? (catData.nombre_traducido || catData.nombre) : categoriaTexto) + '</div>' +
            '<div class="tarjeta-resultado-datos">' + paxHtml + '</div>' +
          '</div>' +
          '<div class="tarjeta-resultado-precio-bloque">' +
            precioHtml +
            '<span class="badge-aproximado">' + TXT.badgeAprox + '</span>' +
            '<div class="tarjeta-resultado-nota">' + TXT.notaTaxi + '</div>' +
          '</div>' +
          botonHtml +
        '</div>' +
        '<p style="text-align:center;font-size:0.82rem;color:#6b5c44;margin:12px 0 0 0;">' + TXT.verOtrasCats + '</p>';
    });
}

function irAReserva() {
  var desde = document.getElementById('desde').value;
  var hasta = document.getElementById('hasta').value;
  var categoriaId = document.getElementById('categoria').value;
  var params = new URLSearchParams({ desde: desde, hasta: hasta, categoria_id: categoriaId });
  window.location.href = RUTA_RESERVA + '?' + params.toString();
}

document.getElementById('ver-precio').addEventListener('click', verPrecio);

function abrirFormCotizacion() {
  var modal = document.getElementById('modal-cotizacion');
  modal.style.display = 'flex';
  // Siempre limpio al abrir
  document.getElementById('cotiz-origen').value = '';
  document.getElementById('cotiz-destino').value = '';
  document.getElementById('cotiz-fecha').value = '';
  document.getElementById('cotiz-pax').value = '';
  document.getElementById('cotiz-email').value = '';
  document.getElementById('cotiz-error').style.display = 'none';
  document.getElementById('cotiz-ok').style.display = 'none';
  var btnEnviar = document.getElementById('btn-enviar-cotizacion');
  var btnCancelar = document.getElementById('btn-cancelar-cotizacion');
  if (btnEnviar) { btnEnviar.disabled = false; btnEnviar.textContent = TXT.enviarSolicitud; btnEnviar.style.display = ''; }
  if (btnCancelar) btnCancelar.textContent = TXT.cancelar;
}

function cerrarFormCotizacion() {
  document.getElementById('modal-cotizacion').style.display = 'none';
  // Restaurar botones para próxima vez
  var btnEnviar = document.getElementById('btn-enviar-cotizacion');
  var btnCancelar = document.getElementById('btn-cancelar-cotizacion');
  if (btnEnviar) { btnEnviar.disabled = false; btnEnviar.textContent = TXT.enviarSolicitud; btnEnviar.style.display = ''; }
  if (btnCancelar) btnCancelar.textContent = TXT.cancelar;
  document.getElementById('cotiz-origen').value = '';
  document.getElementById('cotiz-destino').value = '';
  document.getElementById('cotiz-fecha').value = '';
  document.getElementById('cotiz-pax').value = '';
  document.getElementById('cotiz-email').value = '';
  document.getElementById('cotiz-error').style.display = 'none';
  document.getElementById('cotiz-ok').style.display = 'none';
}

function enviarCotizacion() {
  var origen  = document.getElementById('cotiz-origen').value.trim();
  var destino = document.getElementById('cotiz-destino').value.trim();
  var email   = document.getElementById('cotiz-email').value.trim();
  var fecha   = document.getElementById('cotiz-fecha').value;
  var pax     = document.getElementById('cotiz-pax').value;
  var err     = document.getElementById('cotiz-error');
  var ok      = document.getElementById('cotiz-ok');

  err.style.display = 'none';
  ok.style.display = 'none';

  if (!origen || !destino || !email) {
    err.textContent = TXT.errCampos;
    err.style.display = 'block';
    return;
  }
  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
    err.textContent = TXT.errEmailModal;
    err.style.display = 'block';
    return;
  }

  // Deshabilitar botón para evitar doble envío
  var btnEnviar = document.getElementById('btn-enviar-cotizacion');
  var btnCancelar = document.getElementById('btn-cancelar-cotizacion');
  if (btnEnviar) { btnEnviar.disabled = true; btnEnviar.textContent = TXT.enviando; }

  fetch('/api/cotizaciones', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ origen: origen, destino: destino, fecha_aproximada: fecha || null, num_pasajeros: pax ? Number(pax) : null, email_cliente: email, lang: LANG })
  })
  .then(function(r) { return r.json(); })
  .then(function(data) {
    if (data.error) {
      err.textContent = data.error;
      err.style.display = 'block';
      if (btnEnviar) { btnEnviar.disabled = false; btnEnviar.textContent = TXT.enviarSolicitud; }
      return;
    }
    // Ocultar botones y mostrar mensaje de éxito
    if (btnEnviar) btnEnviar.style.display = 'none';
    if (btnCancelar) btnCancelar.textContent = TXT.cerrar;
    ok.innerHTML = TXT.okMsg.replace('{email}', '<strong>' + email + '</strong>');
    ok.style.display = 'block';
  })
  .catch(function() {
    err.textContent = TXT.errConexion;
    err.style.display = 'block';
    if (btnEnviar) { btnEnviar.disabled = false; btnEnviar.textContent = TXT.enviarSolicitud; }
  });
}

// Cerrar modal al pulsar fuera
document.getElementById('modal-cotizacion').addEventListener('click', function(e) {
  if (e.target === this) cerrarFormCotizacion();
});

// ── Extras ──────────────────────────────────────────────────────────────────
function toggleExtra(id) {
  var ex = extrasData.find(function(e){ return e.id === id; });
  var idx = extrasSeleccionados.findIndex(function(e){ return e.id === id; });
  var item = document.getElementById('extra-' + id);
  var check = document.getElementById('check-' + id);
  if (idx === -1) { extrasSeleccionados.push(ex); item.classList.add('seleccionado'); check.textContent = '✓'; }
  else { extrasSeleccionados.splice(idx,1); item.classList.remove('seleccionado'); check.textContent = ''; }
  var total = extrasSeleccionados.reduce(function(s,e){ return s + Number(e.precio); }, 0);
  var box = document.getElementById('total-extras');
  box.style.display = extrasSeleccionados.length ? 'flex' : 'none';
  document.getElementById('total-extras-precio').textContent = total.toFixed(2) + ' €';
}

// ── Navegación ──────────────────────────────────────────────────────────────
function irAPaso(n) {
  for (var i = 1; i <= 3; i++) {
    var num = document.getElementById('num-' + i);
    var cuerpo = document.getElementById('cuerpo-' + i);
    var cab = document.getElementById('cab-' + i);
    if (i < n) {
      num.className = 'paso-numero completado'; num.textContent = '✓';
      cuerpo.classList.remove('visible');
      // Hacer clickable para volver
      (function(paso){ cab.className = 'paso-cabecera clickable'; cab.onclick = function(){ irAPaso(paso); }; })(i);
    } else if (i === n) {
      num.className = 'paso-numero activo'; num.textContent = i;
      cuerpo.classList.add('visible');
      cab.className = 'paso-cabecera'; cab.onclick = null;
    } else {
      num.className = 'paso-numero'; num.textContent = i;
      cuerpo.classList.remove('visible');
      cab.className = 'paso-cabecera'; cab.onclick = null;
    }
  }
  pasoActual = n;
  document.getElementById('paso-' + n).scrollIntoView({ behavior:'smooth', block:'center' });
}

// ── Validaciones por paso ───────────────────────────────────────────────────
function siguientePaso(desde) {
  if (desde === 1 && !validarPaso1()) return;
  if (desde === 2 && !validarPaso2()) return;
  if (desde === 1) {
    var fecha = document.getElementById('fecha').value;
    var fechaTexto = new Date(fecha + 'T12:00:00').toLocaleDateString(LOCALE, {day:'numeric',month:'long',year:'numeric'});
    document.getElementById('resumen-1').textContent = fechaTexto;
    rellenarResumenPermiso();
  }
  if (desde === 2) {
    var quienViaja = document.getElementById('es-para-otra-persona').checked
      ? document.getElementById('pasajero-nombre').value.trim() + ' ' + document.getElementById('pasajero-apellidos').value.trim()
      : document.getElementById('contacto-nombre').value.trim();
    document.getElementById('resumen-2').textContent = quienViaja;
  }
  irAPaso(desde + 1);
}

function validarPaso1() {
  var ok = true;
  var fecha = document.getElementById('fecha').value;
  document.getElementById('err-fecha').style.display = fecha ? 'none' : 'block';
  if (!fecha) ok = false;

  if (origenEsAero) {
    var h = document.getElementById('hora-llegada-vuelo').value;
    document.getElementById('err-hora-llegada').style.display = h ? 'none' : 'block';
    if (!h) ok = false;
  } else if (origenEsPuerto) {
    var h = document.getElementById('hora-atraque').value;
    document.getElementById('err-hora-atraque').style.display = h ? 'none' : 'block';
    if (!h) ok = false;
  } else {
    var h = document.getElementById('hora-recogida').value;
    document.getElementById('err-hora-recogida').style.display = h ? 'none' : 'block';
    if (!h) ok = false;
    var dOrigen = document.getElementById('direccion-origen').value.trim();
    document.getElementById('err-dir-origen').style.display = dOrigen ? 'none' : 'block';
    if (!dOrigen) ok = false;
  }

  if (!destinoEsAero && !destinoEsPuerto) {
    var dDestino = document.getElementById('direccion-destino').value.trim();
    document.getElementById('err-dir-destino').style.display = dDestino ? 'none' : 'block';
    if (!dDestino) ok = false;
  }
  return ok;
}

function validarPaso2() {
  var ok = true;
  // Titular (quien reserva)
  var nombre = document.getElementById('contacto-nombre').value.trim();
  var telNum = document.getElementById('telefono-numero').value.trim().replace(/\s/g,'');
  var email = document.getElementById('contacto-email').value.trim();
  var telValido = telNum.length >= 7 && /^\d+$/.test(telNum);
  var emailValido = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
  document.getElementById('err-contacto-nombre').style.display = nombre ? 'none' : 'block';
  document.getElementById('err-telefono').style.display = telValido ? 'none' : 'block';
  document.getElementById('err-email').style.display = emailValido ? 'none' : 'block';
  if (!nombre || !telValido || !emailValido) ok = false;
  // Quien viaja (si la reserva es para otra persona)
  if (document.getElementById('es-para-otra-persona').checked) {
    var pNombre = document.getElementById('pasajero-nombre').value.trim();
    var pApellidos = document.getElementById('pasajero-apellidos').value.trim();
    var otraTelNum2 = document.getElementById('otra-persona-telefono').value.trim().replace(/\s/g,'');
    var otraEmail2 = document.getElementById('otra-persona-email').value.trim();
    var otraTelValido2 = otraTelNum2.length >= 7 && /^\d+$/.test(otraTelNum2);
    var otraEmailValido2 = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(otraEmail2);
    document.getElementById('err-pasajero-nombre').style.display = pNombre ? 'none' : 'block';
    document.getElementById('err-pasajero-apellidos').style.display = pApellidos ? 'none' : 'block';
    document.getElementById('err-otra-persona-telefono').style.display = otraTelValido2 ? 'none' : 'block';
    document.getElementById('err-otra-persona-email').style.display = otraEmailValido2 ? 'none' : 'block';
    if (!pNombre || !pApellidos || !otraTelValido2 || !otraEmailValido2) ok = false;
  }
  // Pasaporte/DNI: solo en recogidas en aeropuerto o puerto — del cliente o de quien viaja
  if (origenEsAero || origenEsPuerto) {
    if (document.getElementById('es-para-otra-persona').checked) {
      var pasaporteOtra = document.getElementById('otra-persona-pasaporte').value.trim();
      document.getElementById('err-otra-persona-pasaporte').style.display = pasaporteOtra ? 'none' : 'block';
      if (!pasaporteOtra) ok = false;
    } else {
      var pasaporte = document.getElementById('pasajero-pasaporte').value.trim();
      document.getElementById('err-pasajero-pasaporte').style.display = pasaporte ? 'none' : 'block';
      if (!pasaporte) ok = false;
    }
  }
  return ok;
}

function toggleOtraPersona(marcado) {
  document.getElementById('bloque-otra-persona').classList.toggle('bloque-oculto', !marcado);
  // El pasaporte del cliente solo se muestra si viaja él (y la recogida es en aeropuerto/puerto)
  if (origenEsAero || origenEsPuerto) {
    document.getElementById('bloque-pasaporte').style.display = marcado ? 'none' : 'block';
    if (marcado) document.getElementById('err-pasajero-pasaporte').style.display = 'none';
  }
  if (!marcado) {
    document.getElementById('pasajero-nombre').value = '';
    document.getElementById('pasajero-apellidos').value = '';
    document.getElementById('otra-persona-pasaporte').value = '';
    document.getElementById('otra-persona-telefono').value = '';
    document.getElementById('otra-persona-prefijo').value = '+34';
    document.getElementById('otra-persona-email').value = '';
    document.getElementById('err-pasajero-nombre').style.display = 'none';
    document.getElementById('err-pasajero-apellidos').style.display = 'none';
    document.getElementById('err-otra-persona-pasaporte').style.display = 'none';
    document.getElementById('err-otra-persona-telefono').style.display = 'none';
    document.getElementById('err-otra-persona-email').style.display = 'none';
  }
}

// ── Resumen y envío ─────────────────────────────────────────────────────────
function mostrarResumen() {
  if (!validarPaso2()) { irAPaso(2); return; }
  var nombre = document.getElementById('contacto-nombre').value.trim();
  var telNum = document.getElementById('telefono-numero').value.trim().replace(/\s/g,'');
  var email = document.getElementById('contacto-email').value.trim();

  var esOtraPersona = document.getElementById('es-para-otra-persona').checked;
  var otraTelNum = document.getElementById('otra-persona-telefono').value.trim().replace(/\s/g,'');
  var otraTel = document.getElementById('otra-persona-prefijo').value + ' ' + otraTelNum;
  var otraEmail = document.getElementById('otra-persona-email').value.trim();

  var fecha = document.getElementById('fecha').value;
  var fechaTexto = new Date(fecha + 'T12:00:00').toLocaleDateString(LOCALE, {day:'numeric',month:'long',year:'numeric'});
  var horaTexto = origenEsAero ? TXT.resLlegadaVuelo + ' ' + document.getElementById('hora-llegada-vuelo').value
    : origenEsPuerto ? TXT.resAtraque + ' ' + document.getElementById('hora-atraque').value
    : document.getElementById('hora-recogida').value;
  var pasajero = esOtraPersona
    ? document.getElementById('pasajero-nombre').value.trim() + ' ' + document.getElementById('pasajero-apellidos').value.trim()
    : nombre;
  var tel = document.getElementById('telefono-prefijo').value + ' ' + telNum;
  var dirDestino = (!destinoEsAero && !destinoEsPuerto) ? document.getElementById('direccion-destino').value.trim() : '';
  var dirOrigen = (!origenEsAero && !origenEsPuerto) ? document.getElementById('direccion-origen').value.trim() : '';

  if (!pnrGenerado) pnrGenerado = generarPNR();

  var html =
    '<strong>' + TXT.resNumero + '</strong> ' + pnrGenerado + '<br>' +
    '<strong>' + TXT.resOrigen + '</strong> ' + ORIGEN_MOSTRAR + (dirOrigen ? ' — ' + dirOrigen : '') + '<br>' +
    '<strong>' + TXT.resDestino + '</strong> ' + DESTINO_MOSTRAR + (dirDestino ? ' — ' + dirDestino : '') + '<br>' +
    (categoriaNombre ? '<strong>' + TXT.resCategoria + '</strong> ' + categoriaNombre + '<br>' : '') +
    '<strong>' + TXT.resFecha + '</strong> ' + fechaTexto + '<br>' +
    '<strong>' + TXT.resHora + '</strong> ' + horaTexto + '<br>' +
    '<strong>' + TXT.resPasajeros + '</strong> ' + document.getElementById('num-pasajeros').value + '<br>' +
    (precioEstimado ? '<strong>' + TXT.resPrecio + '</strong> ' + Number(precioEstimado).toFixed(0) + ' €<br>' : '') +
    (extrasSeleccionados.length ? '<strong>' + TXT.resExtras + '</strong> ' + extrasSeleccionados.map(function(e){ return (e.nombre_traducido || e.nombre) + ' (' + Number(e.precio).toFixed(2) + ' €)'; }).join(', ') + '<br>' : '') +
    '<strong>' + TXT.resPasajero + '</strong> ' + pasajero + '<br>' +
    ((origenEsAero || origenEsPuerto) ? '<strong>' + TXT.resPasaporte + '</strong> ' + (esOtraPersona ? document.getElementById('otra-persona-pasaporte').value.trim() : document.getElementById('pasajero-pasaporte').value.trim()) + '<br>' : '') +
    (esOtraPersona ? '<strong>' + TXT.resOtraPersona + '</strong> — ' + TXT.resContactoViaja + ' ' + otraTel + ' · ' + otraEmail + '<br>' : '') +
    '<strong>' + TXT.resContacto + '</strong> ' + nombre + ' · ' + tel + ' · ' + email;

  document.getElementById('resumen-final-contenido').innerHTML = html;
  document.getElementById('resumen-titulo').innerHTML = TXT.resumenTitulo + '<br><span style="font-family:\'JetBrains Mono\',monospace;font-size:16px;letter-spacing:2px;color:var(--terracota);">' + pnrGenerado + '</span>';
  document.getElementById('resumen-final').style.display = 'block';
  var btn = document.getElementById('boton-enviar');
  btn.textContent = TXT.botonConfirmar;
  btn.onclick = confirmarEnvio;
}

function confirmarEnvio() {
  var btn = document.getElementById('boton-enviar');
  btn.disabled = true; btn.textContent = TXT.enviando;

  var tel = document.getElementById('telefono-prefijo').value + ' ' + document.getElementById('telefono-numero').value.trim().replace(/\s/g,'');
  var dirOrigen = (!origenEsAero && !origenEsPuerto) ? document.getElementById('direccion-origen').value.trim() : '';
  var dirDestino = (!destinoEsAero && !destinoEsPuerto) ? document.getElementById('direccion-destino').value.trim() : '';
  var hora = origenEsAero ? document.getElementById('hora-llegada-vuelo').value
    : origenEsPuerto ? document.getElementById('hora-atraque').value
    : document.getElementById('hora-recogida').value;

  var datos = {
    numero_reserva_cliente: pnrGenerado,
    origen: paramOrigen + (dirOrigen ? ' — ' + dirOrigen : ''),
    destino: paramDestino + (dirDestino ? ' — ' + dirDestino : ''),
    categoria_id: paramCategoriaId,
    precio_estimado: precioEstimado,
    fecha: document.getElementById('fecha').value,
    hora: hora,
    tipo_llegada: origenEsAero ? 'aeropuerto' : origenEsPuerto ? 'puerto' : 'otra',
    numero_vuelo: document.getElementById('vuelo-llegada') ? document.getElementById('vuelo-llegada').value.trim() : '',
    hora_llegada_vuelo: origenEsAero ? document.getElementById('hora-llegada-vuelo').value : '',
    nombre_barco: origenEsPuerto ? document.getElementById('barco-llegada').value.trim() : '',
    hora_atraque: origenEsPuerto ? document.getElementById('hora-atraque').value : '',
    num_pasajeros: document.getElementById('num-pasajeros').value,
    pasajero_nombre: document.getElementById('es-para-otra-persona').checked
      ? document.getElementById('pasajero-nombre').value.trim() + ' ' + document.getElementById('pasajero-apellidos').value.trim()
      : document.getElementById('contacto-nombre').value.trim(),
    pasaporte_dni: (origenEsAero || origenEsPuerto)
      ? (document.getElementById('es-para-otra-persona').checked
          ? document.getElementById('otra-persona-pasaporte').value.trim()
          : document.getElementById('pasajero-pasaporte').value.trim())
      : '',
    notas: document.getElementById('pasajero-notas').value.trim(),
    nombre_cliente: document.getElementById('contacto-nombre').value.trim(),
    telefono_cliente: tel,
    email_cliente: document.getElementById('contacto-email').value.trim(),
    es_para_otra_persona: document.getElementById('es-para-otra-persona').checked,
    nombre_pasajero_otro: document.getElementById('es-para-otra-persona').checked
      ? document.getElementById('pasajero-nombre').value.trim() + ' ' + document.getElementById('pasajero-apellidos').value.trim()
      : '',
    telefono_pasajero_otro: document.getElementById('es-para-otra-persona').checked
      ? document.getElementById('otra-persona-prefijo').value + ' ' + document.getElementById('otra-persona-telefono').value.trim().replace(/\s/g,'')
      : '',
    email_pasajero_otro: document.getElementById('otra-persona-email').value.trim(),
    extras: extrasSeleccionados.map(function(e){ return { id: e.id, precio: e.precio }; })
  };

  fetch('/api/reservas', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(datos)
  })
  .then(function(r){ return r.json(); })
  .then(function(d){
    if (d.ok) {
      document.querySelectorAll('.paso').forEach(function(p){ p.style.display = 'none'; });
      document.getElementById('tarjeta-traslado').style.display = 'none';
      if (d.numero_reserva) {
        document.getElementById('numero-reserva-mostrar').textContent = d.numero_reserva;
      }
      document.getElementById('confirmacion').style.display = 'block';
      window.scrollTo({ top:0, behavior:'smooth' });
    } else {
      document.getElementById('err-envio').textContent = d.error || TXT.errEnvio;
      document.getElementById('err-envio').style.display = 'block';
      btn.disabled = false; btn.textContent = TXT.botonConfirmar;
    }
  })
  .catch(function(){
    document.getElementById('err-envio').textContent = TXT.errConexion;
    document.getElementById('err-envio').style.display = 'block';
    btn.disabled = false; btn.textContent = TXT.botonConfirmar;
  });
}

