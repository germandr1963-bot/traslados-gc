}



// ── Autocompletado de direcciones con Nominatim ─────────────────────────────
var nominatimTimers = {};

function buscarDireccion(campo) {
  var inputId = campo === 'origen' ? 'direccion-origen' : 'direccion-destino';
  var listaId = campo === 'origen' ? 'sugerencias-origen' : 'sugerencias-destino';
  var input = document.getElementById(inputId);
  var lista = document.getElementById(listaId);
  var texto = input.value.trim();

  if (texto.length < 3) { lista.style.display = 'none'; return; }

  clearTimeout(nominatimTimers[campo]);
  nominatimTimers[campo] = setTimeout(function() {
    var base = 'https://nominatim.openstreetmap.org/search?format=json&limit=8&accept-language=' + LANG +
      '&countrycodes=es&viewbox=-18.6,29.6,-13.0,27.2&bounded=1&q=';
    // Municipio de la ruta para acotar la búsqueda (origen o destino según el campo)
    var municipio = campo === 'origen' ? (paramOrigen || '') : (paramDestino || '');

    function pintar(resultados) {
      lista.innerHTML = '';
      if (!resultados.length) { lista.style.display = 'none'; return; }
      resultados.forEach(function(r) {
        var nombre = r.display_name.split(',').slice(0, 4).join(',').trim();
        var div = document.createElement('div');
        div.className = 'sugerencia-item';
        div.textContent = nombre;
        div.onclick = function() {
          input.value = nombre;
          lista.style.display = 'none';
        };
        lista.appendChild(div);
      });
      lista.style.display = 'block';
    }

    // 1º: búsqueda acotada al municipio; 2º: si no hay nada, se amplía a Canarias
    fetch(base + encodeURIComponent(municipio ? texto + ', ' + municipio : texto), { headers: { 'Accept-Language': LANG } })
      .then(function(r){ return r.json(); })
      .then(function(resultados) {
        if (resultados.length || !municipio) { pintar(resultados); return; }
        fetch(base + encodeURIComponent(texto), { headers: { 'Accept-Language': LANG } })
          .then(function(r){ return r.json(); })
          .then(pintar)
          .catch(function(){ lista.style.display = 'none'; });
      })
      .catch(function(){ lista.style.display = 'none'; });
  }, 400);
}

// Cerrar sugerencias al hacer clic fuera
document.addEventListener('click', function(e) {
  if (!e.target.closest('.campo-grupo')) {
    document.querySelectorAll('.sugerencias-lista').forEach(function(l){ l.style.display = 'none'; });
  }
});

function reiniciarFormulario() {
  if (confirm(TXT.confirmReiniciar)) {
    window.location.href = clienteConSesion ? RUTA_RESERVA : URL_HOME;
  }
}

// ── Navegación según sesión ─────────────────────────────────────────────────
// Si el cliente tiene la sesión abierta, todo lo devuelve a su panel,
// nunca a la web pública. La única salida es "Cerrar sesión" en el panel.
var clienteConSesion = false;
fetch('/api/cliente/sesion').then(function(r){ return r.json(); }).then(function(s){
  if (!s.autenticado) return;
  clienteConSesion = true;
  var volver = document.querySelector('.boton-volver');
  if (volver) {
    volver.textContent = TXT.volverPanel;
    volver.href = '/cliente/portal';
  }
  var linkFinal = document.getElementById('link-final-inicio');
  if (linkFinal) {
    linkFinal.textContent = TXT.volverPanelFin;
    linkFinal.href = '/cliente/portal';
  }
});
