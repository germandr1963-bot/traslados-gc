<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title><%= seo.meta_title || (seo.origen + ' → ' + seo.destino + ' — ' + nombreMarca) %></title>

<% if (seo.meta_description) { %>
<meta name="description" content="<%= seo.meta_description %>">
<% } %>

<meta name="robots" content="<%= seo.robots_status || 'index,follow' %>">

<!-- Open Graph -->
<meta property="og:type" content="website">
<meta property="og:site_name" content="<%= nombreMarca %>">
<meta property="og:title" content="<%= seo.og_title || seo.meta_title || (seo.origen + ' → ' + seo.destino) %>">
<% if (seo.og_description || seo.meta_description) { %>
<meta property="og:description" content="<%= seo.og_description || seo.meta_description %>">
<% } %>
<% if (seo.canonical_url) { %>
<meta property="og:url" content="<%= seo.canonical_url %>">
<% } %>
<% if (seo.tiene_imagen) { %>
<meta property="og:image" content="<%= BASE_URL %>/ruta-imagen/<%= seo.ruta_id %>">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<% } else if (tieneImagenDefecto) { %>
<meta property="og:image" content="<%= BASE_URL %>/imagen-og-defecto">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<% } %>

<!-- Twitter / X (solo si está activado en los ajustes globales) -->
<% if (twitterActivo) { %>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="<%= seo.og_title || seo.meta_title || (seo.origen + ' → ' + seo.destino) %>">
<% if (seo.og_description || seo.meta_description) { %>
<meta name="twitter:description" content="<%= seo.og_description || seo.meta_description %>">
<% } %>
<% if (seo.tiene_imagen) { %>
<meta name="twitter:image" content="<%= BASE_URL %>/ruta-imagen/<%= seo.ruta_id %>">
<% } else if (tieneImagenDefecto) { %>
<meta name="twitter:image" content="<%= BASE_URL %>/imagen-og-defecto">
<% } %>
<% } %>

<!-- Canonical -->
<% if (seo.canonical_url) { %>
<link rel="canonical" href="<%= seo.canonical_url %>">
<% } %>

<!-- Datos estructurados (Schema.org) — le dicen a Google qué es exactamente
     esta página: un servicio de transporte concreto, con su precio real. -->
<script type="application/ld+json"><%- JSON.stringify(schemaTaxiService).replace(/<\/script>/gi, '<\\/script>') %></script>
<script type="application/ld+json"><%- JSON.stringify(schemaBreadcrumb).replace(/<\/script>/gi, '<\\/script>') %></script>

<!-- Hreflang: una etiqueta por cada idioma activo de esta ruta -->
<% alternates.forEach(function(alt) { %>
<link rel="alternate" hreflang="<%= alt.lang_code %>" href="<%= BASE_URL %>/<%= alt.lang_code %>/<%= SECCIONES_TRASLADO[alt.lang_code] %>/<%= alt.slug_url %>">
<% }); %>
<!-- x-default apunta siempre a la versión en español -->
<link rel="alternate" hreflang="x-default" href="<%= BASE_URL %>/es/<%= SECCIONES_TRASLADO['es'] %>/<%= seo.slug_url %>">

<link href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@500&family=Public+Sans:wght@400;500&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/estilos.css">
<style>
body { background: var(--gris-fondo); color: var(--texto-oscuro); min-height: 100vh; }

/* ── Cinta superior — idéntica a destino-pagina.html ── */
header.app {
  background: var(--charcoal);
  padding: 16px 20px;
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  border-bottom: 3px solid var(--terracota);
}
header.app .marca {
  font-family: 'Big Shoulders Display', sans-serif;
  font-size: 28px;
  font-weight: 500;
  color: var(--texto-claro);
  letter-spacing: 2px;
  text-decoration: none;
  text-align: center;
  justify-self: center;
}
header.app a.nav { color: rgba(255,255,255,0.65); text-decoration: none; font-size: 14px; }
header.app a.nav:hover { color: #fff; }
header.app a.nav.izquierda { justify-self: start; }
header.app .derecha-header { justify-self: end; }

/* ── Contenido principal ── */
.contenido {
  max-width: 860px;
  margin: 0 auto;
  padding: 40px 24px 80px;
}

/* ── Foto de cabecera ── */
.foto-cabecera {
  width: 100%;
  height: 400px;
  background: var(--charcoal);
  border-radius: 12px;
  overflow: hidden;
  margin-bottom: 32px;
}
.foto-cabecera img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* ── Título ── */
h1.titulo-ruta {
  font-family: 'Big Shoulders Display', sans-serif;
  font-size: clamp(32px, 6vw, 52px);
  margin-bottom: 16px;
  line-height: 1.1;
  text-align: center;
}
h1.titulo-ruta .acento { color: var(--terracota); }

/* ── Subtítulo y botón ── */
.subtitulo-ruta {
  font-size: 15px;
  color: var(--texto-muted);
  text-align: center;
  margin-bottom: 24px;
}
.boton-reservar {
  display: inline-block;
  background: var(--terracota);
  color: white;
  font-family: 'Big Shoulders Display', sans-serif;
  font-size: 20px;
  letter-spacing: 1px;
  padding: 16px 40px;
  border-radius: 8px;
  text-decoration: none;
  transition: opacity 0.2s;
}
.boton-reservar:hover { opacity: 0.88; }


/* ── Secciones de contenido ── */
.seccion {
  margin: 40px 0;
  padding: 0;
}
.seccion h2 {
  font-family: 'Big Shoulders Display', sans-serif;
  font-weight: 500;
  font-size: 24px;
  margin-bottom: 18px;
  color: var(--texto-oscuro);
}
.tabla-tarifas {
  width: 100%;
  border-collapse: collapse;
  font-size: 14px;
}
.tabla-tarifas th {
  background: var(--charcoal);
  color: var(--texto-claro);
  padding: 10px 14px;
  text-align: left;
  font-weight: 500;
  font-family: 'Big Shoulders Display', sans-serif;
  font-size: 13px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}
.tabla-tarifas td {
  padding: 10px 14px;
  border-bottom: 1px solid var(--gris-borde);
  color: var(--texto-oscuro);
}
.tabla-tarifas th:nth-child(4),
.tabla-tarifas td:nth-child(4) { text-align: right; }

.precio-fijo {
  font-weight: 500;
  font-size: 16px;
  color: var(--texto-oscuro);
}
.badge-fijo {
  background: var(--oro);
  color: var(--oro-texto);
  font-size: 11px;
  font-weight: 500;
  padding: 3px 9px;
  border-radius: 10px;
  margin-left: 8px;
}
.consultar {
  color: var(--texto-muted);
  font-style: italic;
}
.tres-columnas {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 18px;
}
footer {
  text-align: center;
  padding: 30px;
  color: var(--texto-muted);
  font-size: 13px;
}
footer a { color: var(--texto-muted); text-decoration: none; margin: 0 12px; font-size: 13px; }
footer a:hover { color: var(--texto-oscuro); }
.footer-links { margin-bottom: 12px; }

/* ── Texto descriptivo ── */
.texto-ruta {
  font-size: 15px;
  line-height: 1.75;
  color: var(--texto-oscuro);
  margin-bottom: 48px;
}

.texto-ruta p  { margin: 0 0 14px; }
.texto-ruta ul { padding-left: 20px; margin: 0 0 14px; }
.texto-ruta li { margin-bottom: 6px; }

/* ── Grid de fotos ── */
.fotos-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14px;
  margin-bottom: 48px;
}
.foto-item {
  height: 220px;
  background: var(--charcoal);
  border-radius: 10px;
  overflow: hidden;
}
.foto-item img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* ── Migas de pan ── */
.breadcrumbs { font-size: 13px; color: var(--texto-muted); margin-bottom: 18px; }
.breadcrumbs a { color: var(--texto-muted); text-decoration: none; }
.breadcrumbs a:hover { text-decoration: underline; }

/* ── Responsive móvil ── */
@media (max-width: 560px) {
  header.app { padding: 12px 14px; }
  header.app .marca { font-size: 19px; letter-spacing: 1px; }
  header.app a.nav { font-size: 12px; }
  .contenido { padding: 24px 16px 60px; }
  .foto-cabecera { height: 220px; border-radius: 8px; }
  h1.titulo-ruta { font-size: clamp(24px, 7vw, 36px); }
  .boton-reservar { display: block; text-align: center; padding: 14px 20px; font-size: 17px; }
  .seccion { padding: 0 14px; margin: 28px auto; }
  .fotos-grid { grid-template-columns: 1fr; }
  .foto-item { height: 200px; }
  .tabla-tarifas { font-size: 13px; }
  .tabla-tarifas th,
  .tabla-tarifas td { padding: 8px 8px; }
  .tabla-tarifas th:nth-child(3),
  .tabla-tarifas td:nth-child(3) { display: none; }
  .tres-columnas { grid-template-columns: 1fr; gap: 12px; }
}
</style>
</head>
<body>

<header class="app">
  <a href="<%= lang === 'es' ? '/rutas' : '/' + lang + '/' + (palabrasPaginas.rutas || 'rutas') %>" class="nav izquierda"><%= t('nav_volver_rutas') %></a>
  <a href="<%= lang === 'es' ? '/' : '/' + lang + '/' %>" class="marca"><%= nombreMarca %></a>
  <div class="derecha-header">
    <a href="<%= lang === 'es' ? '/contacto' : '/' + lang + '/' + (palabrasPaginas.contacto || 'contacto') %>" class="nav"><%= t('nav_contacto') %></a>
  </div>
</header>

<div class="contenido">
  <nav class="breadcrumbs">
    <a href="<%= lang === 'es' ? '/' : '/' + lang + '/' %>"><%= t('nav_inicio') || 'Inicio' %></a>
    <span> › </span>
    <a href="<%= lang === 'es' ? '/rutas' : '/' + lang + '/' + (palabrasPaginas.rutas || 'rutas') %>"><%= t('home_footer_rutas') || 'Rutas' %></a>
    <span> › </span>
    <span><%= seo.origen %> → <%= seo.destino %></span>
  </nav>

  <h1 class="titulo-ruta">
    <%= seo.origen %> <span class="acento">→</span> <%= seo.destino %>
  </h1>
  <p class="subtitulo-ruta"><%= t('subtitulo_hero') %></p>

  <div class="foto-cabecera">
    <% if (fotoCabeceraId) { %>
    <img src="/ruta-foto/<%= fotoCabeceraId %>" alt="<%= seo.origen %> → <%= seo.destino %>">
    <% } %>
  </div>

<div class="seccion">
  <h2><%= t('titulo_tarifas') %></h2>
  <% if (precios.length > 0) { %>
  <table class="tabla-tarifas">
    <thead>
      <tr>
        <th><%= t('tabla_columna_categoria') %></th>
        <th><%= t('tabla_columna_pasajeros') %></th>
        <th><%= t('tabla_columna_equipaje') %></th>
        <th><%= t('tabla_columna_precio') %></th>
      </tr>
    </thead>
    <tbody>
      <% precios.forEach(function(p) { %>
      <tr>
        <td><strong><%= p.nombre %></strong></td>
        <td><%= p.capacidad_pasajeros %> <%= t('sufijo_pax') %></td>
        <td><%= p.capacidad_maletas %></td>
        <td>
          <% if (p.precio) { %>
            <span class="precio-fijo"><%= Number(p.precio).toFixed(0) %> €</span>
            <span class="badge-fijo"><%= t('badge_precio_fijo') %></span>
          <% } else { %>
            <span class="consultar"><%= t('texto_a_consultar') %></span>
          <% } %>
        </td>
      </tr>
      <% }); %>
    </tbody>
  </table>
  <% } else { %>
  <p style="color:var(--texto-muted);font-size:14px;"><%= t('texto_consulta_disponibilidad') %></p>
  <% } %>
  <p style="margin-top:20px;">
    <a href="<%= lang === 'es' ? '/' : '/' + lang + '/' %>" class="boton-reservar"><%= t('boton_solicitar_traslado') %></a>
  </p>
</div>

<div class="seccion">
  <h2><%= t('titulo_como_funciona') %></h2>
  <div class="tres-columnas">
    <div class="tarjeta">
      <strong><%= t('paso1_titulo') %></strong>
      <p style="margin-top:8px;font-size:14px;color:var(--texto-muted);"><%= t('paso1_texto') %></p>
    </div>
    <div class="tarjeta">
      <strong><%= t('paso2_titulo') %></strong>
      <p style="margin-top:8px;font-size:14px;color:var(--texto-muted);"><%= t('paso2_texto') %></p>
    </div>
    <div class="tarjeta">
      <strong><%= t('paso3_titulo') %></strong>
      <p style="margin-top:8px;font-size:14px;color:var(--texto-muted);"><%= t('paso3_texto') %></p>
    </div>
  </div>
</div>

<% if (relacionadas && relacionadas.length > 0) { %>
<div class="seccion">
  <h2><%= t('titulo_rutas_relacionadas') %> <%= seo.origen %></h2>
  <div class="tres-columnas">
    <% relacionadas.forEach(function(r) { %>
    <a href="/<%= lang %>/<%= SECCIONES_TRASLADO[lang] %>/<%= r.slug_url %>" class="tarjeta" style="text-decoration:none;color:inherit;display:block;">
      <strong><%= seo.origen %> → <%= r.destino %></strong>
    </a>
    <% }); %>
  </div>
</div>
<% } %>

<% if (seo.texto_descripcion) { %>
<div class="seccion">
  <div class="texto-ruta"><%- seo.texto_descripcion %></div>
</div>
<% } %>

<% if (fotosRuta && fotosRuta.length > 0) { %>
<div class="seccion">
  <div class="fotos-grid">
    <% fotosRuta.forEach(function(f) { %>
    <div class="foto-item">
      <img src="/ruta-foto/<%= f.id %>" alt="<%= f.alt_texto %>">
    </div>
    <% }); %>
  </div>
</div>
<% } %>

</div><!-- fin .contenido -->

<footer>
  <div class="footer-links">
    <a href="/<%= lang %>/<%= palabrasPaginas.rutas || 'rutas' %>"><%= t('home_footer_rutas') %></a>
    <a href="/<%= lang %>/<%= palabrasPaginas.destinos || 'destinos' %>"><%= t('home_footer_destinos') %></a>
    <a href="/<%= lang %>/<%= palabrasPaginas.flota || 'flota' %>"><%= t('home_footer_flota') %></a>
    <a href="/<%= lang %>/<%= palabrasPaginas.contacto || 'contacto' %>"><%= t('home_footer_contacto') %></a>
    <% if (lang === 'es') { %>
    <a href="/chofer/acceso/alta"><%= t('home_footer_alta_choferes') %></a>
    <a href="/chofer/acceso"><%= t('home_footer_acceso_choferes') %></a>
    <% } %>
    <a href="/<%= lang %>/<%= palabrasPaginas['mi-reserva'] || 'mi-reserva' %>"><%= t('home_footer_acceso_clientes') %></a>
  </div>
  <%= nombreMarca %> — Gran Canaria
</footer>

</body>
</html>
