function poblarSelect(select, valores) {
  // valores: lista de objetos { valor, etiqueta }
  // valor = nombre en español (interno, para buscar ruta y precio)
  // etiqueta = nombre traducido (lo que ve el visitante)
  var primera = select.options[0] ? select.options[0].textContent : '';
  select.innerHTML = '<option value="">' + primera + '</option>';
  valores.forEach(function (v) {
    var opt = document.createElement('option');
    opt.value = v.valor;
    opt.textContent = v.etiqueta;
    select.appendChild(opt);
  });
  // Sincronizar el dropdown visual
  sincronizarDropdown(select.id);
}

// ── Dropdowns personalizados ──────────────────────────────────────────────────
function sincronizarDropdown(selectId) {
  var select = document.getElementById(selectId);
  var box = document.getElementById(selectId + '-box');
  var dropdown = document.getElementById(selectId + '-dropdown');
  if (!select || !box || !dropdown) return;

  var textoActual = select.options[select.selectedIndex] ? select.options[select.selectedIndex].textContent : '';
  var valorActual = select.value;

  // Actualizar el box
  if (!valorActual) {
    box.textContent = select.options[0] ? select.options[0].textContent : '';
    box.classList.add('placeholder-activo');
  } else {
    box.textContent = textoActual;
    box.classList.remove('placeholder-activo');
  }

  // Reconstruir el dropdown
  dropdown.innerHTML = '';
  for (var i = 0; i < select.options.length; i++) {
    (function(i) {
      var opt = select.options[i];
      var div = document.createElement('div');
      div.className = 'custom-select-option' + (i === 0 ? ' placeholder-option' : '') + (opt.value === valorActual ? ' seleccionada' : '');
      div.textContent = opt.textContent;
      div.addEventListener('click', function() {
        select.value = opt.value;
        dropdown.classList.remove('abierto');
        sincronizarDropdown(selectId);
        // Disparar el evento change del select original
        var evento = new Event('change', { bubbles: true });
        select.dispatchEvent(evento);
      });
      dropdown.appendChild(div);
    })(i);
  }
}

function iniciarDropdowns() {
  ['desde', 'hasta', 'categoria'].forEach(function(id) {
    var box = document.getElementById(id + '-box');
    var dropdown = document.getElementById(id + '-dropdown');
    if (!box || !dropdown) return;

    box.addEventListener('click', function(e) {
      e.stopPropagation();
      // Cerrar otros dropdowns abiertos
      ['desde', 'hasta', 'categoria'].forEach(function(otherId) {
        if (otherId !== id) {
          var otherDropdown = document.getElementById(otherId + '-dropdown');
          if (otherDropdown) otherDropdown.classList.remove('abierto');
        }
      });
      dropdown.classList.toggle('abierto');
    });
  });

  // Cerrar al hacer clic fuera
  document.addEventListener('click', function() {
    ['desde', 'hasta', 'categoria'].forEach(function(id) {
      var dropdown = document.getElementById(id + '-dropdown');
      if (dropdown) dropdown.classList.remove('abierto');
    });
  });
}

function cargarRutas() {
  fetch('/api/rutas?lang=' + LANG).then(function (r) { return r.json(); }).then(function (rutas) {
    // (17/10/2026) Llega desde Flota con una categoría: Desde y Hasta solo con las rutas que tienen precio para esa categoría
    var catFlota = new URLSearchParams(window.location.search).get('categoria');
    var rutasTodas = rutas;
    function rutasDeCategoria(catId) {
      if (!catId) return rutasTodas;
      return rutasTodas.filter(function (r) {
        return r.categorias_con_precio && r.categorias_con_precio.map(String).indexOf(String(catId)) !== -1;
      });
    }
    if (catFlota) rutas = rutasDeCategoria(catFlota);
    rutasDisponibles = rutas;
    var vistosO = {}, origenes = [];
    var vistosD = {}, destinos = [];
    rutas.forEach(function (r) {
      if (!vistosO[r.origen]) { vistosO[r.origen] = true; origenes.push({ valor: r.origen, etiqueta: r.origen_traducido || r.origen }); }
      if (!vistosD[r.destino]) { vistosD[r.destino] = true; destinos.push({ valor: r.destino, etiqueta: r.destino_traducido || r.destino }); }
    });
    poblarSelect(document.getElementById('desde'), origenes);
    poblarSelect(document.getElementById('hasta'), destinos);
    var paramDesde = new URLSearchParams(window.location.search).get('desde');
    var paramHasta = new URLSearchParams(window.location.search).get('hasta');

    // Si llega destino preseleccionado, filtrar origenes
    if (paramHasta) {
      var vistosF = {}, filtradosO = [];
      rutasDisponibles.forEach(function (r) {
        if (r.destino === paramHasta && !vistosF[r.origen]) {
          vistosF[r.origen] = true;
          filtradosO.push({ valor: r.origen, etiqueta: r.origen_traducido || r.origen });
        }
      });
      if (filtradosO.length > 0) {
        filtradosO.sort(function(a,b){ return a.etiqueta.localeCompare(b.etiqueta); });
        poblarSelect(document.getElementById('desde'), filtradosO);
      }
    }

    // Si llega origen preseleccionado, filtrar destinos
    if (paramDesde) {
      var vistosF2 = {}, filtradosD = [];
      rutasDisponibles.forEach(function (r) {
        if (r.origen === paramDesde && !vistosF2[r.destino]) {
          vistosF2[r.destino] = true;
          filtradosD.push({ valor: r.destino, etiqueta: r.destino_traducido || r.destino });
        }
      });
      if (filtradosD.length > 0) {
        filtradosD.sort(function(a,b){ return a.etiqueta.localeCompare(b.etiqueta); });
        poblarSelect(document.getElementById('hasta'), filtradosD);
      }
    }

    // Asignar los dos valores al final para que no se pisen entre sí
    if (paramDesde) { document.getElementById('desde').value = paramDesde; sincronizarDropdown('desde'); }
    if (paramHasta) { document.getElementById('hasta').value = paramHasta; sincronizarDropdown('hasta'); }

    if (paramDesde || paramHasta) actualizarCategoriasSegunRuta();
    if (rutas.length === 0) {
      document.getElementById('resultado-precio').textContent = TXT.eligeRuta;
    }

    // Filtrado bidireccional: origen filtra destino, destino filtra origen
    document.getElementById('desde').addEventListener('change', function () {
      var origenVal = this.value;
      var selectHasta = document.getElementById('hasta');
      var hastaVal = selectHasta.value;
      if (!origenVal) {
        poblarSelect(selectHasta, destinos);
      } else {
        var vistos = {}, filtrados = [];
        rutasDisponibles.forEach(function (r) {
          if (r.origen === origenVal && !vistos[r.destino]) {
            vistos[r.destino] = true;
            filtrados.push({ valor: r.destino, etiqueta: r.destino_traducido || r.destino });
          }
        });
        filtrados.sort(function(a,b){ return a.etiqueta.localeCompare(b.etiqueta); });
        poblarSelect(selectHasta, filtrados);
      }
      if (hastaVal) { selectHasta.value = hastaVal; sincronizarDropdown('hasta'); }
      actualizarCategoriasSegunRuta();
    });

    document.getElementById('hasta').addEventListener('change', function () {
      var destinoVal = this.value;
      var selectDesde = document.getElementById('desde');
      var desdeVal = selectDesde.value;
      if (!destinoVal) {
        poblarSelect(selectDesde, origenes);
      } else {
        var vistos = {}, filtrados = [];
        rutasDisponibles.forEach(function (r) {
          if (r.destino === destinoVal && !vistos[r.origen]) {
            vistos[r.origen] = true;
            filtrados.push({ valor: r.origen, etiqueta: r.origen_traducido || r.origen });
          }
        });
        filtrados.sort(function(a,b){ return a.etiqueta.localeCompare(b.etiqueta); });
        poblarSelect(selectDesde, filtrados);
      }
      if (desdeVal) { selectDesde.value = desdeVal; sincronizarDropdown('desde'); }
      actualizarCategoriasSegunRuta();
    });

    // (17/10/2026) Llegó desde Flota: si el cliente cambia de categoría, Desde y Hasta pasan a las rutas con precio de la nueva categoría
    if (catFlota) {
      document.getElementById('categoria').addEventListener('change', function () {
        rutasDisponibles = rutasDeCategoria(this.value);
        var selDesde = document.getElementById('desde');
        var selHasta = document.getElementById('hasta');
        var desdeAntes = selDesde.value, hastaAntes = selHasta.value;
        var vO = {}, vD = {};
        origenes = []; destinos = [];
        rutasDisponibles.forEach(function (r) {
          if (!vO[r.origen]) { vO[r.origen] = true; origenes.push({ valor: r.origen, etiqueta: r.origen_traducido || r.origen }); }
          if (!vD[r.destino]) { vD[r.destino] = true; destinos.push({ valor: r.destino, etiqueta: r.destino_traducido || r.destino }); }
        });
        poblarSelect(selDesde, origenes);
        if (desdeAntes && origenes.some(function (o) { return o.valor === desdeAntes; })) { selDesde.value = desdeAntes; sincronizarDropdown('desde'); }
        var listaHasta = destinos;
        if (selDesde.value) {
          var vF = {}; listaHasta = [];
          rutasDisponibles.forEach(function (r) {
            if (r.origen === selDesde.value && !vF[r.destino]) { vF[r.destino] = true; listaHasta.push({ valor: r.destino, etiqueta: r.destino_traducido || r.destino }); }
          });
          listaHasta.sort(function (a, b) { return a.etiqueta.localeCompare(b.etiqueta); });
        }
        poblarSelect(selHasta, listaHasta);
        if (hastaAntes && listaHasta.some(function (o) { return o.valor === hastaAntes; })) { selHasta.value = hastaAntes; sincronizarDropdown('hasta'); }
        document.getElementById('resultado-precio').innerHTML = '';
      });
    }
  });
}

// (15/10/2026) Fecha del viaje: hoy (Canarias), mínimo hoy o mañana según Modelo de negocio
var CONFIG_FECHA = { hoy: null, mismo_dia: true };
function fechaBusqueda() { return document.getElementById('fecha-busqueda').value; }
function sumarDia(ymd) { var d = new Date(ymd + 'T12:00:00Z'); d.setUTCDate(d.getUTCDate() + 1); return d.toISOString().slice(0, 10); }
function prepararFechaBusqueda() {
  var input = document.getElementById('fecha-busqueda');
  var paramFecha = new URLSearchParams(window.location.search).get('fecha');
  if (paramFecha && /^\d{4}-\d{2}-\d{2}$/.test(paramFecha)) input.value = paramFecha;
  fetch('/api/reservas-config').then(function (r) { return r.json(); }).then(function (c) {
    CONFIG_FECHA = c;
    input.min = c.mismo_dia ? c.hoy : sumarDia(c.hoy);
    document.getElementById('cotiz-fecha').min = input.min; // (16/10/2026) misma regla en "¿No encuentras tu ruta?"
    comprobarFechaBusqueda();
  }).catch(function () {});
  input.addEventListener('change', function () {
    comprobarFechaBusqueda();
    document.getElementById('resultado-precio').innerHTML = '';
    cargarCategorias();
  });
}
// Si no se aceptan reservas del mismo día, la fecha de hoy simplemente no vale: se quita sin avisar
function comprobarFechaBusqueda() {
  var input = document.getElementById('fecha-busqueda');
  var f = input.value;
  if (f && input.min && f < input.min) { input.value = ''; return false; }
  return true;
}

function cargarCategorias() {
  var _f = fechaBusqueda();
  fetch('/api/categorias?lang=' + LANG + (_f ? '&fecha=' + encodeURIComponent(_f) : '')).then(function (r) { return r.json(); }).then(function (categorias) {
    categoriasDisponibles = categorias;
    var paramCategoria = new URLSearchParams(window.location.search).get('categoria');
    // (17/10/2026) Llega desde Flota sin fecha y esa categoría no está en la lista: se añade desde la flota completa para que salga marcada
    if (paramCategoria && !_f && !categorias.some(function (c) { return String(c.id) === String(paramCategoria); })) {
      fetch('/api/categorias-publicas?lang=' + LANG).then(function (r) { return r.json(); }).then(function (todas) {
        var cat = todas.find(function (c) { return String(c.id) === String(paramCategoria); });
        if (cat && !fechaBusqueda()) { categorias.push(cat); pintarCategoriaFlota(categorias, paramCategoria); }
      }).catch(function () {});
    }
    pintarCategoriaFlota(categorias, paramCategoria);
  });
}

function pintarCategoriaFlota(categorias, paramCategoria) {
    if (paramCategoria) {
      var select = document.getElementById('categoria');
      // (17/10/2026) Si ya hay ruta elegida, la lista sale de esa ruta; si no, se respeta la categoría que tenga elegida el cliente
      if (document.getElementById('desde').value && document.getElementById('hasta').value) { actualizarCategoriasSegunRuta(); return; }
      var elegida = select.value || paramCategoria;
      select.innerHTML = '<option value="">' + TXT.selecciona + '</option>';
      categorias.forEach(function (c) {
        var opt = document.createElement('option');
        opt.value = c.id;
        opt.textContent = (c.nombre_traducido || c.nombre) + ' (' + c.capacidad_pasajeros + ' ' + TXT.paxSufijo + ')';
        if (String(c.id) === String(elegida)) opt.selected = true;
        select.appendChild(opt);
      });
      sincronizarDropdown('categoria'); // (17/10/2026) que se vea marcada la categoría que llega de Flota, igual que Desde/Hasta
    } else {
      actualizarCategoriasSegunRuta();
    }
}

function actualizarCategoriasSegunRuta() {
  var desdeVal = document.getElementById('desde').value;
  var hastaVal = document.getElementById('hasta').value;
  var select = document.getElementById('categoria');
  var valorActual = select.value || new URLSearchParams(window.location.search).get('categoria') || '';

  var ruta = rutasDisponibles.find(function (r) { return r.origen === desdeVal && r.destino === hastaVal; })
          || rutasDisponibles.find(function (r) { return r.origen === hastaVal && r.destino === desdeVal; });

  // (17/10/2026) Llegó desde Flota: mientras la ruta no está completa, la categoría elegida se mantiene
  if ((!ruta || !desdeVal || !hastaVal) && new URLSearchParams(window.location.search).get('categoria')) return;

  select.innerHTML = '<option value="">' + TXT.selecciona + '</option>';

  if (!ruta || !desdeVal || !hastaVal) return;

  var categoriasRuta = categoriasDisponibles.filter(function (c) {
    return ruta.categorias_con_precio && ruta.categorias_con_precio.indexOf(c.id) !== -1;
  });

  categoriasRuta.forEach(function (c) {
    var opt = document.createElement('option');
    opt.value = c.id;
    opt.textContent = (c.nombre_traducido || c.nombre) + ' (' + c.capacidad_pasajeros + ' ' + TXT.paxSufijo + ')';
    if (String(c.id) === String(valorActual)) opt.selected = true;
    select.appendChild(opt);
  });
  // (15/10/2026) Ruta sin ningún vehículo ese día: se avisa
  if (!categoriasRuta.length && fechaBusqueda() && comprobarFechaBusqueda()) {
    document.getElementById('resultado-precio').innerHTML = '<div class="resultado-vacio">' + TXT.sinCatsFecha + '</div>';
  }

  if (valorActual && !categoriasRuta.find(function(c) { return String(c.id) === String(valorActual); })) {
    document.getElementById('resultado-precio').innerHTML = '';
  }
  sincronizarDropdown('categoria');
}

function verPrecio() {
  var desdeVal = document.getElementById('desde').value;
  var hastaVal = document.getElementById('hasta').value;
  var categoriaId = document.getElementById('categoria').value;
  var resultado = document.getElementById('resultado-precio');

  // (15/10/2026) Primero la fecha
  if (!fechaBusqueda()) { resultado.innerHTML = '<div class="resultado-vacio">' + TXT.eligeFecha + '</div>'; return; }
  if (!comprobarFechaBusqueda()) { resultado.innerHTML = '<div class="resultado-vacio">' + TXT.eligeFecha + '</div>'; return; }

  if (!desdeVal || !hastaVal || !categoriaId) {
    resultado.innerHTML = '<div class="resultado-vacio">' + TXT.eligeRuta + '</div>';
    return;
  }

  var ruta = rutasDisponibles.find(function (r) { return r.origen === desdeVal && r.destino === hastaVal; })
          || rutasDisponibles.find(function (r) { return r.origen === hastaVal && r.destino === desdeVal; });
  var categoriaSelect = document.getElementById('categoria');
  var catData = categoriasDisponibles.find(function (c) { return String(c.id) === String(categoriaId); });

  if (!ruta) {
    resultado.innerHTML = '<div class="resultado-vacio">' + TXT.aConsultar + '</div>';
    return;
  }

  fetch('/api/precio?ruta_id=' + ruta.id + '&categoria_id=' + categoriaId)
    .then(function (r) { return r.json(); })
    .then(function (data) {
      var fotoHtml = catData && catData.foto
        ? '<img class="tarjeta-resultado-foto" src="' + catData.foto + '" alt="' + (catData.nombre_traducido || catData.nombre || '') + '">'
        : '<div class="tarjeta-resultado-foto-placeholder">🚗</div>';

      var paxHtml = catData
        ? '<div class="tarjeta-resultado-dato">' +
            '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#D9A441" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>' +
            catData.capacidad_pasajeros + ' ' + TXT.paxSufijo +
          '</div>' +
          (catData.capacidad_maletas
            ? '<div class="tarjeta-resultado-dato">' +
                '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#D9A441" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/><line x1="12" y1="12" x2="12" y2="16"/><line x1="10" y1="14" x2="14" y2="14"/></svg>' +
                (catData.capacidad_maletas_traducida || catData.capacidad_maletas) +
              '</div>'
            : '')
        : '';

      var precioHtml = data.a_consultar
        ? '<span class="precio precio-grande" style="font-size:22px;">' + TXT.aConsultar + '</span>'
        : '<span class="precio precio-grande">' + Number(data.precio).toFixed(0) + ' €</span>';

      var botonHtml = '<button class="boton-reservar" onclick="irAReserva()">' + TXT.botonReservar + '</button>';

      resultado.innerHTML =
        '<div class="tarjeta-resultado">' +
          fotoHtml +
          '<div class="tarjeta-resultado-info">' +
            '<div class="tarjeta-resultado-nombre">' + (catData ? (catData.nombre_traducido || catData.nombre) : '') + '</div>' +
            '<div class="tarjeta-resultado-datos">' + paxHtml + '</div>' +
          '</div>' +
          '<div class="tarjeta-resultado-precio-bloque">' +
            precioHtml +
            '<span class="badge-aproximado">' + TXT.badgeAprox + '</span>' +
            '<div class="tarjeta-resultado-nota">' + TXT.notaTaxi + '</div>' +
          '</div>' +
          botonHtml +
        '</div>' +
        '<p style="text-align:center;font-size:0.82rem;color:#6b5c44;margin:12px 0 0 0;">' + TXT.verOtrasCats + '</p>';
    });
}

function irAReserva() {
  var desde = document.getElementById('desde').value;
  var hasta = document.getElementById('hasta').value;
  var categoriaId = document.getElementById('categoria').value;
  var params = new URLSearchParams({ desde: desde, hasta: hasta, categoria_id: categoriaId, fecha: fechaBusqueda() });
  window.location.href = RUTA_RESERVA + '?' + params.toString();
}

document.getElementById('ver-precio').addEventListener('click', verPrecio);
cargarFondo();
iniciarDropdowns();
cargarRutas();
prepararFechaBusqueda(); // (15/10/2026) antes de cargar las categorías: la fecha decide cuáles hay
cargarCategorias();

function abrirFormCotizacion() {
  var modal = document.getElementById('modal-cotizacion');
  modal.style.display = 'flex';
  document.getElementById('cotiz-origen').value = '';
  document.getElementById('cotiz-destino').value = '';
  document.getElementById('cotiz-fecha').value = '';
  document.getElementById('cotiz-pax').value = '';
  document.getElementById('cotiz-email').value = '';
  document.getElementById('cotiz-error').style.display = 'none';
  document.getElementById('cotiz-ok').style.display = 'none';
  var btnEnviar = document.getElementById('btn-enviar-cotizacion');
  var btnCancelar = document.getElementById('btn-cancelar-cotizacion');
  if (btnEnviar) { btnEnviar.disabled = false; btnEnviar.textContent = TXT.enviarSolicitud; btnEnviar.style.display = ''; }
  if (btnCancelar) btnCancelar.textContent = TXT.cancelar;
}

function cerrarFormCotizacion() {
  document.getElementById('modal-cotizacion').style.display = 'none';
  var btnEnviar = document.getElementById('btn-enviar-cotizacion');
  var btnCancelar = document.getElementById('btn-cancelar-cotizacion');
  if (btnEnviar) { btnEnviar.disabled = false; btnEnviar.textContent = TXT.enviarSolicitud; btnEnviar.style.display = ''; }
  if (btnCancelar) btnCancelar.textContent = TXT.cancelar;
  document.getElementById('cotiz-origen').value = '';
  document.getElementById('cotiz-destino').value = '';
  document.getElementById('cotiz-fecha').value = '';
  document.getElementById('cotiz-pax').value = '';
  document.getElementById('cotiz-email').value = '';
  document.getElementById('cotiz-error').style.display = 'none';
  document.getElementById('cotiz-ok').style.display = 'none';
}

function enviarCotizacion() {
  var origen  = document.getElementById('cotiz-origen').value.trim();
  var destino = document.getElementById('cotiz-destino').value.trim();
  var email   = document.getElementById('cotiz-email').value.trim();
  var fecha   = document.getElementById('cotiz-fecha').value;
  // (16/10/2026) Misma regla de fechas que la reserva: un día que ya no vale se quita sin avisar
  var _minCotiz = document.getElementById('cotiz-fecha').min;
  if (fecha && _minCotiz && fecha < _minCotiz) { document.getElementById('cotiz-fecha').value = ''; fecha = ''; }
  var pax     = document.getElementById('cotiz-pax').value;
  var err     = document.getElementById('cotiz-error');
  var ok      = document.getElementById('cotiz-ok');

  err.style.display = 'none';
  ok.style.display = 'none';

  if (!origen || !destino || !email) {
    err.textContent = TXT.errCampos;
    err.style.display = 'block';
    return;
  }
  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
    err.textContent = TXT.errEmail;
    err.style.display = 'block';
    return;
  }

  var btnEnviar = document.getElementById('btn-enviar-cotizacion');
  var btnCancelar = document.getElementById('btn-cancelar-cotizacion');
  if (btnEnviar) { btnEnviar.disabled = true; btnEnviar.textContent = TXT.enviando; }

  fetch('/api/cotizaciones', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ origen: origen, destino: destino, fecha_aproximada: fecha || null, num_pasajeros: pax ? Number(pax) : null, email_cliente: email, lang: LANG })
  })
  .then(function(r) { return r.json(); })
  .then(function(data) {
    if (data.error) {
      err.textContent = data.error;
      err.style.display = 'block';
      if (btnEnviar) { btnEnviar.disabled = false; btnEnviar.textContent = TXT.enviarSolicitud; }
      return;
    }
    if (btnEnviar) btnEnviar.style.display = 'none';
    if (btnCancelar) btnCancelar.textContent = TXT.cerrar;
    ok.innerHTML = '<strong>' + TXT.okMsg.replace('{email}', '<strong>' + email + '</strong>') + '</strong>';
    ok.style.display = 'block';
  })
  .catch(function() {
    err.textContent = TXT.errConexion;
    err.style.display = 'block';
    if (btnEnviar) { btnEnviar.disabled = false; btnEnviar.textContent = TXT.enviarSolicitud; }
  });
}

document.getElementById('modal-cotizacion').addEventListener('click', function(e) {
  if (e.target === this) cerrarFormCotizacion();
});


</script>

